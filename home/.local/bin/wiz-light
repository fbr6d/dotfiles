#!/usr/bin/env python3
"""WiZ 조명 제어 (제어센터 swaync용, 로컬 UDP 38899 — 외부 서버 안 씀).

사용법:
  wiz-light state            켜져 있으면 true, 꺼져 있으면 false 출력 (토글 버튼 update-command)
  wiz-light toggle           SWAYNC_TOGGLE_STATE(true/false)에 맞춰 켜기/끄기, 없으면 반전
  wiz-light on | off
  wiz-light get-brightness   밝기(10~100) 출력 (슬라이더 cmd_getter)
  wiz-light set-brightness N 밝기 설정 + 켜기 (슬라이더 cmd_setter)
  wiz-light warm             따뜻한 빛 2700K (조명이 켜져 있을 때만)
  wiz-light focus            집중용 흰 빛 5000K (조명이 켜져 있을 때만)
  wiz-light color            제어센터를 닫고 색 고르기 창을 띄워 그 색으로 바꿈 (켜져 있을 때만)
  wiz-light rgb RRGGBB       그 색으로 바꿈 (켜져 있을 때만)
  wiz-light status-json      전구 상태 JSON 한 줄 (swaync-status가 제어센터 표시용으로 읽음)
  wiz-light status-all-json  모든 전구 상태 {"floor": {...}, "desk": {...}} (미쿠 셸 제어센터)

전구 고르기: 맨 앞에 --lamp floor|desk|all 을 붙인다 (없으면 floor = 플로어등).
  floor = 플로어등, desk = 제도등, all = 둘 다
  예) wiz-light --lamp desk on / wiz-light --lamp all warm

조명이 꺼져 있으면 warm / focus / color / rgb 는 아무것도 하지 않는다
(제어센터 조명 줄의 오른쪽 세 버튼).

전구 IP는 ~/.cache/wiz-light/ip 에 기억하고, 응답이 없으면 같은 네트워크에서
MAC 주소로 다시 찾는다 (공유기가 IP를 바꿔도 동작).
"""
import json
import re
import subprocess
import os
import socket
import sys
import time

# 전구: 이름 → (MAC, IP 기억 파일)
LAMPS = {
    "floor": ("9877d5e783c4", os.path.expanduser("~/.cache/wiz-light/ip")),       # 플로어등
    "desk": ("9877d5e74bb6", os.path.expanduser("~/.cache/wiz-light/ip-desk")),   # 제도등
}
MAC, CACHE = LAMPS["floor"]
PORT = 38899
WARM_K, FOCUS_K = 2700, 5000


def _sock(timeout):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    s.settimeout(timeout)
    return s


def _ask(ip, method, params=None, timeout=0.8, tries=2):
    msg = json.dumps({"method": method, "params": params or {}}).encode()
    s = _sock(timeout)
    try:
        for _ in range(tries):
            s.sendto(msg, (ip, PORT))
            try:
                data, _ = s.recvfrom(4096)
                return json.loads(data)
            except (socket.timeout, ValueError):
                continue
    finally:
        s.close()
    return None


def _discover():
    msg = json.dumps({"method": "getPilot", "params": {}}).encode()
    s = _sock(0.3)
    try:
        for _ in range(3):
            s.sendto(msg, ("255.255.255.255", PORT))
            end = time.time() + 1.0
            while time.time() < end:
                try:
                    data, addr = s.recvfrom(4096)
                    r = json.loads(data).get("result", {})
                    if r.get("mac") == MAC:
                        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
                        with open(CACHE, "w") as f:
                            f.write(addr[0])
                        return addr[0]
                except (socket.timeout, ValueError):
                    pass
    finally:
        s.close()
    return None


def call(method, params=None):
    ip = None
    try:
        ip = open(CACHE).read().strip()
    except OSError:
        pass
    if ip:
        r = _ask(ip, method, params)
        if r is not None:
            return r
    ip = _discover()
    return _ask(ip, method, params) if ip else None


def use(lamp):
    global MAC, CACHE
    MAC, CACHE = LAMPS[lamp]


def pilot():
    r = call("getPilot")
    return (r or {}).get("result") or {}


def main():
    argv = sys.argv[1:]
    lamp = "floor"
    if len(argv) >= 2 and argv[0] == "--lamp":
        lamp, argv = argv[1], argv[2:]
    if lamp != "all" and lamp not in LAMPS:
        sys.exit("전구 이름은 floor / desk / all 중 하나예요")
    cmd = argv[0] if argv else "state"
    if cmd == "status-all-json":
        # 전구마다 따로 프로세스로 물어봐 동시에 기다린다 (한 전구가 꺼져 있어도 느려지지 않게)
        procs = {k: subprocess.Popen([sys.executable, os.path.abspath(__file__), "--lamp", k, "status-json"],
                                     stdout=subprocess.PIPE, text=True) for k in LAMPS}
        out = {}
        for k, pr in procs.items():
            try:
                out[k] = json.loads(pr.communicate(timeout=6)[0] or "{}")
            except (subprocess.TimeoutExpired, ValueError):
                pr.kill()
                out[k] = {"error": "no-reply"}
        print(json.dumps(out))
        return
    if lamp == "all":
        # 둘 다: 전구마다 같은 명령을 동시에 실행 (색 고르기 창은 한 번만)
        if cmd == "color":
            if not any(_on(k) for k in LAMPS):
                return
            subprocess.run(["qs", "-c", "miku-shell", "ipc", "call", "cc", "close"], capture_output=True)
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "--lamp", "all", "color-pick"],
                             start_new_session=True, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        if cmd == "color-pick":
            lit = [k for k in LAMPS if _on(k)]
            if not lit:
                return
            use(lit[0])
            hexv = _pick_color(pilot())
            if hexv:
                cmd, argv = "rgb", ["rgb", hexv]
            else:
                return
        procs = [subprocess.Popen([sys.executable, os.path.abspath(__file__), "--lamp", k] + ([cmd] + argv[1:]))
                 for k in LAMPS]
        for pr in procs:
            pr.wait()
        return
    use(lamp)
    if cmd == "state":
        print("true" if pilot().get("state") else "false")
    elif cmd == "toggle":
        want = os.environ.get("SWAYNC_TOGGLE_STATE")
        on = (want == "true") if want in ("true", "false") else not pilot().get("state")
        call("setPilot", {"state": on})
    elif cmd in ("on", "off"):
        call("setPilot", {"state": cmd == "on"})
    elif cmd == "get-brightness":
        print(int(pilot().get("dimming", 10)))
    elif cmd == "set-brightness":
        try:
            v = int(float(argv[1]))
        except (IndexError, ValueError):
            sys.exit("밝기 값이 필요해요 (10~100)")
        call("setPilot", {"state": True, "dimming": max(10, min(100, v))})
    elif cmd in ("warm", "focus"):
        if pilot().get("state"):
            call("setPilot", {"temp": WARM_K if cmd == "warm" else FOCUS_K})
    elif cmd == "color":
        # 꺼져 있으면 아무것도 안 함. 켜져 있으면 제어센터를 닫고 색 고르기 창을
        # 따로 띄운다 (창을 기다리는 동안 swaync 버튼이 묶이지 않게)
        if not pilot().get("state"):
            return
        subprocess.run(["qs", "-c", "miku-shell", "ipc", "call", "cc", "close"], capture_output=True)
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--lamp", lamp, "color-pick"],
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif cmd == "color-pick":
        hexv = _pick_color(pilot())
        if hexv and pilot().get("state"):
            call("setPilot", {"r": int(hexv[0:2], 16), "g": int(hexv[2:4], 16), "b": int(hexv[4:6], 16)})
    elif cmd == "rgb":
        try:
            h = argv[1].lstrip("#")
            r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
        except (IndexError, ValueError):
            sys.exit("색 값이 필요해요 (예: 39C5BB)")
        if pilot().get("state"):
            call("setPilot", {"r": r, "g": g, "b": b})
    elif cmd == "status-json":
        r = call("getPilot")
        print(json.dumps((r or {}).get("result") or {"error": "no-reply"}))
    else:
        sys.exit(__doc__)


def _on(lamp):
    use(lamp)
    return bool(pilot().get("state"))


def _pick_color(p):
    """zenity 색 고르기 창 → 'RRGGBB' (취소하면 None)"""
    args = ["zenity", "--color-selection", "--show-palette", "--title", "조명 색 고르기"]
    if all(k in p for k in "rgb"):
        args += ["--color", f"rgb({p['r']},{p['g']},{p['b']})"]
    out = subprocess.run(args, capture_output=True, text=True).stdout
    nums = re.findall(r"[\d.]+", out)
    if len(nums) < 3:
        return None
    return "".join(f"{max(0, min(255, round(float(x)))):02X}" for x in nums[:3])


if __name__ == "__main__":
    main()
