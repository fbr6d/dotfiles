#!/usr/bin/env python3
# Control center popup (macOS Control Center style) opened from the waybar menu
# button. Wi-Fi (nmcli), Bluetooth (bluetoothctl), sound (wpctl/pactl),
# display brightness (brightnessctl) and battery status.
# Hyprland rules for class "local.control.center" float it under the bar and
# close it when another window takes focus; Esc closes it too.
import json
import os
import re
import subprocess
import tempfile
import threading
import time

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import GLib, Gtk, Pango

APP_ID = "local.control.center"
REFRESH_MS = 3000

# Colors: monochrome dark (Claude grays); Catppuccin Mocha only for highlighted text
CSS = """
