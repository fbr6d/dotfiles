# Nerd Font icons
ICON_WIFI = "󰤨"
ICON_WIFI_OFF = "󰤭"
ICON_BT = "󰂯"
ICON_BT_OFF = "󰂲"
ICON_LOCK = "󰌾"
ICON_CHECK = "󰄬"
ICON_SUN = "󰃠"
ICON_VOL = "󰕾"
ICON_MUTE = "󰝟"
ICON_CHEVRON = "󰅂"
ICON_CHEVRON_OPEN = "󰅀"
SIGNAL = ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]


def run(*args, timeout=10):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def in_thread(work, done=None):
    """Run work() off the UI thread, then done(result) on it."""
    def body():
        result = work()
        if done:
            GLib.idle_add(lambda: (done(result), False)[1])
    threading.Thread(target=body, daemon=True).start()


def split_terse(line):
    """Split one line of `nmcli -t` output (':' separated, '\\:' escaped)."""
    return [f.replace("\\:", ":").replace("\\\\", "\\") for f in re.split(r"(?<!\\):", line)]


# ---------------------------------------------------------------- backends

class Wifi:
    @staticmethod
    def device():
        _, out = run("nmcli", "-t", "-f", "DEVICE,TYPE", "dev")
        for line in out.splitlines():
            f = split_terse(line)
            if len(f) >= 2 and f[1] == "wifi":
                return f[0]
        return None

    @staticmethod
    def enabled():
        _, out = run("nmcli", "-t", "-f", "WIFI", "radio")
        return out.strip() == "enabled"

    @staticmethod
    def set_enabled(on):
        run("nmcli", "radio", "wifi", "on" if on else "off")

    @staticmethod
    def networks(rescan=False):
        _, out = run("nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list",
                     "--rescan", "yes" if rescan else "auto", timeout=20)
        best = {}
        for line in out.splitlines():
            f = split_terse(line)
            if len(f) < 4 or not f[1]:
                continue
            net = {"active": f[0] == "*", "ssid": f[1], "signal": int(f[2] or 0),
                   "secure": f[3] not in ("", "--")}
            old = best.get(net["ssid"])
            if not old or net["active"] or (not old["active"] and net["signal"] > old["signal"]):
                best[net["ssid"]] = net
        return sorted(best.values(), key=lambda n: (not n["active"], -n["signal"]))

    @staticmethod
    def known():
        _, out = run("nmcli", "-t", "-f", "NAME,TYPE", "con", "show")
        return {split_terse(l)[0] for l in out.splitlines() if l.endswith(":802-11-wireless")}

    @staticmethod
    def connect(ssid, password=None):
        if password is None and ssid in Wifi.known():
            code, _ = run("nmcli", "con", "up", "id", ssid, timeout=40)
            return code == 0
        if password is None:
            code, _ = run("nmcli", "dev", "wifi", "connect", ssid, timeout=40)
            return code == 0
        # Pass the password through a private file, not the command line
        fd, path = tempfile.mkstemp(dir=os.environ.get("XDG_RUNTIME_DIR"))
        try:
            with os.fdopen(fd, "w") as f:
                f.write("802-11-wireless-security.psk:" + password + "\n")
            code, _ = run("nmcli", "--ask", "dev", "wifi", "connect", ssid, "passwd-file", path, timeout=40)
        finally:
            os.remove(path)
        return code == 0


class Bluetooth:
    @staticmethod
    def available():
        code, out = run("bluetoothctl", "show", timeout=5)
        return code == 0 and "Controller" in out

    @staticmethod
    def powered():
        _, out = run("bluetoothctl", "show", timeout=5)
        return "Powered: yes" in out

    @staticmethod
    def set_powered(on):
        run("bluetoothctl", "power", "on" if on else "off", timeout=10)

    @staticmethod
    def _devices(*filt):
        _, out = run("bluetoothctl", "devices", *filt, timeout=5)
        devs = {}
        for line in out.splitlines():
            parts = line.split(" ", 2)
            if len(parts) == 3 and parts[0] == "Device":
                devs[parts[1]] = parts[2]
        return devs

    @staticmethod
    def paired():
        devs = []
        for mac, name in Bluetooth._devices("Paired").items():
            _, info = run("bluetoothctl", "info", mac, timeout=5)
            devs.append({"mac": mac, "name": name, "connected": "Connected: yes" in info})
        return sorted(devs, key=lambda d: (not d["connected"], d["name"].lower()))

    @staticmethod
    def discover(seconds=8):
        paired = Bluetooth._devices("Paired")
        run("bluetoothctl", "--timeout", str(seconds), "scan", "on", timeout=seconds + 5)
        found = Bluetooth._devices()
        return [{"mac": m, "name": n} for m, n in found.items()
                if m not in paired and n.replace("-", ":") != m]

    @staticmethod
    def set_connected(mac, on):
        code, _ = run("bluetoothctl", "connect" if on else "disconnect", mac, timeout=20)
        return code == 0

    @staticmethod
    def pair(mac):
        for cmd in ("pair", "trust", "connect"):
            code, _ = run("bluetoothctl", cmd, mac, timeout=30)
            if code != 0 and cmd != "trust":
                return False
        return True


class Sound:
    @staticmethod
    def volume():
        _, out = run("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@", timeout=5)
        m = re.search(r"Volume:\s*([\d.]+)", out)
        return (round(float(m.group(1)) * 100) if m else 0), "MUTED" in out

    @staticmethod
    def set_volume(pct):
        run("wpctl", "set-volume", "-l", "1", "@DEFAULT_AUDIO_SINK@", f"{pct}%", timeout=5)

    @staticmethod
    def toggle_mute():
        run("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle", timeout=5)

    @staticmethod
    def outputs():
        _, out = run("pactl", "-f", "json", "list", "sinks", timeout=5)
        _, default = run("pactl", "get-default-sink", timeout=5)
        try:
            sinks = json.loads(out)
        except ValueError:
            return []
        return [{"name": s["name"], "label": s.get("description") or s["name"],
                 "active": s["name"] == default.strip()} for s in sinks]

    @staticmethod
    def set_output(name):
        run("pactl", "set-default-sink", name, timeout=5)


class Display:
    @staticmethod
    def brightness():
        _, out = run("brightnessctl", "-m", timeout=5)
        parts = out.strip().split(",")
        return int(parts[3].rstrip("%")) if len(parts) > 3 else 100

    @staticmethod
    def set_brightness(pct):
        run("brightnessctl", "-q", "set", f"{max(pct, 1)}%", timeout=5)


def battery():
    base = "/sys/class/power_supply/BAT0"
    try:
        cap = int(open(f"{base}/capacity").read())
        status = open(f"{base}/status").read().strip()
    except (OSError, ValueError):
        return None
    return cap, status


# ---------------------------------------------------------------- UI helpers

def label(text, *classes, xalign=0.0, **kw):
    lab = Gtk.Label(label=text, xalign=xalign, **kw)
    for c in classes:
        lab.add_css_class(c)
    return lab


def clear(box):
    while child := box.get_first_child():
        box.remove(child)


class Toggle:
    """Square tile: circle button toggles the feature, the rest opens details."""

    def __init__(self, icon, title, on_toggle, on_open):
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, hexpand=True)
        self.box.add_css_class("tile")
        top = Gtk.Box(spacing=6)
        self.circle = Gtk.Button(label=icon, halign=Gtk.Align.START)
        self.circle.add_css_class("circle")
        self.circle.connect("clicked", lambda *_: on_toggle())
        self.chevron = Gtk.Button(label=ICON_CHEVRON, halign=Gtk.Align.END, hexpand=True)
        self.chevron.add_css_class("plain")
        self.chevron.add_css_class("chevron")
        self.chevron.connect("clicked", lambda *_: on_open())
        top.append(self.circle)
        top.append(self.chevron)

        text = Gtk.Button()
        text.add_css_class("plain")
        text.connect("clicked", lambda *_: on_open())
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        col.append(label(title, "title"))
        self.subtitle = label("", "subtitle", ellipsize=Pango.EllipsizeMode.END, max_width_chars=14)
        col.append(self.subtitle)
        text.set_child(col)

        self.box.append(top)
        self.box.append(text)

    def update(self, on, icon, subtitle, highlight=False, sensitive=True):
        self.circle.set_label(icon)
        self.circle.set_sensitive(sensitive)
        (self.circle.add_css_class if on else self.circle.remove_css_class)("on")
        self.subtitle.set_text(subtitle)
        (self.subtitle.add_css_class if highlight else self.subtitle.remove_css_class)("highlight")

    def set_open(self, is_open):
        self.chevron.set_label(ICON_CHEVRON_OPEN if is_open else ICON_CHEVRON)


class SliderTile:
    def __init__(self, title, icon, on_change, icon_button=None):
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.box.add_css_class("tile")
        self.box.add_css_class("tile-wide")
        head = Gtk.Box()
        head.append(label(title, "section", hexpand=True))
        self.extra = Gtk.Box()
        head.append(self.extra)
        self.box.append(head)

        row = Gtk.Box(spacing=8)
        if icon_button:
            self.icon = Gtk.Button(label=icon)
            self.icon.add_css_class("plain")
            self.icon.add_css_class("slider-icon")
            self.icon.connect("clicked", lambda *_: icon_button())
        else:
            self.icon = label(icon, "slider-icon", xalign=0.5)
        row.append(self.icon)
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        self.scale.connect("value-changed", self._changed)
        row.append(self.scale)
        self.box.append(row)

        self.on_change = on_change
        self.touched = 0.0
        self.pending = None
        self.updating = False

    def _changed(self, scale):
        if self.updating:
            return
        self.touched = time.monotonic()
        if self.pending:
            GLib.source_remove(self.pending)
        value = int(scale.get_value())
        self.pending = GLib.timeout_add(60, self._apply, value)

    def _apply(self, value):
        self.pending = None
        in_thread(lambda: self.on_change(value))
        return False

    def set(self, value):
        # Do not fight the user while they drag
        if time.monotonic() - self.touched < 1.5:
            return
        self.updating = True
        self.scale.set_value(value)
        self.updating = False

    def set_icon(self, icon):
        self.icon.set_label(icon)


# ---------------------------------------------------------------- window

class ControlCenter(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.connect("activate", self.build)
        self.open_detail = None
        self.password_for = None
        self.bt_found = []
        self.bt_scanning = False

    def build(self, app):
        if self.get_windows():
            self.get_windows()[0].present()
            return
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        win = Gtk.ApplicationWindow(application=app, title="제어 센터", resizable=False)
        Gtk.StyleContext.add_provider_for_display(
            win.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win.set_default_size(360, -1)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda c, k, *_: (win.close(), True)[1] if k == 0xff1b else False)
        win.add_controller(keys)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        root.add_css_class("root")
        root.set_size_request(360, -1)

        tiles = Gtk.Box(spacing=10, homogeneous=True)
        self.wifi = Toggle(ICON_WIFI, "Wi-Fi", self.toggle_wifi, lambda: self.show_detail("wifi"))
        self.bt = Toggle(ICON_BT, "Bluetooth", self.toggle_bt, lambda: self.show_detail("bt"))
        tiles.append(self.wifi.box)
        tiles.append(self.bt.box)
        root.append(tiles)

        self.detail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.detail.add_css_class("detail")
        self.revealer = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN,
                                     transition_duration=180)
        self.revealer.set_child(self.detail)
        root.append(self.revealer)

        self.display = SliderTile("디스플레이", ICON_SUN, Display.set_brightness)
        root.append(self.display.box)

        self.sound = SliderTile("사운드", ICON_VOL, Sound.set_volume,
                                icon_button=lambda: in_thread(Sound.toggle_mute, lambda _: self.refresh()))
        out_btn = Gtk.Button(label=ICON_CHEVRON)
        out_btn.add_css_class("plain")
        out_btn.add_css_class("chevron")
        out_btn.connect("clicked", lambda *_: self.show_detail("sound"))
        self.sound_chevron = out_btn
        self.sound.extra.append(out_btn)
        root.append(self.sound.box)

        self.battery = label("", "battery")
        root.append(self.battery)

        win.set_child(root)
        win.present()

        self.state = {}
        self.refresh()
        GLib.timeout_add(REFRESH_MS, lambda: (self.refresh(), True)[1])

    # ----- state

    def refresh(self):
        def work():
            dev = Wifi.device()
            bt_ok = Bluetooth.available()
            return {
                "wifi_dev": dev,
                "wifi_on": Wifi.enabled() if dev else False,
                "wifi_nets": Wifi.networks() if dev else [],
                "bt_ok": bt_ok,
                "bt_on": Bluetooth.powered() if bt_ok else False,
                "bt_devs": Bluetooth.paired() if bt_ok else [],
                "volume": Sound.volume(),
                "outputs": Sound.outputs(),
                "brightness": Display.brightness(),
                "battery": battery(),
            }
        in_thread(work, self.apply)

    def apply(self, s):
        self.state = s
        # Wi-Fi tile
        if not s["wifi_dev"]:
            self.wifi.update(False, ICON_WIFI_OFF, "장치 없음", sensitive=False)
        elif not s["wifi_on"]:
            self.wifi.update(False, ICON_WIFI_OFF, "끔")
        else:
            cur = next((n["ssid"] for n in s["wifi_nets"] if n["active"]), None)
            self.wifi.update(True, ICON_WIFI, cur or "연결 안 됨", highlight=bool(cur))
        # Bluetooth tile
        if not s["bt_ok"]:
            self.bt.update(False, ICON_BT_OFF, "장치 없음", sensitive=False)
        elif not s["bt_on"]:
            self.bt.update(False, ICON_BT_OFF, "끔")
        else:
            conn = [d["name"] for d in s["bt_devs"] if d["connected"]]
            self.bt.update(True, ICON_BT, ", ".join(conn) if conn else "켬", highlight=bool(conn))
        # Sliders
        vol, muted = s["volume"]
        self.sound.set(vol)
        self.sound.set_icon(ICON_MUTE if muted else ICON_VOL)
        self.display.set(s["brightness"])
        # Battery
        bat = s["battery"]
        for c in ("charging", "low"):
            self.battery.remove_css_class(c)
        if bat:
            cap, status = bat
            text = {"Charging": "충전 중", "Full": "충전 완료", "Not charging": "전원 연결됨"}.get(status, "배터리 사용 중")
            self.battery.set_text(f"배터리 {cap}% · {text}")
            if status == "Charging":
                self.battery.add_css_class("charging")
            elif cap <= 20:
                self.battery.add_css_class("low")
        if self.open_detail:
            self.render_detail()

    # ----- tiles

    def toggle_wifi(self):
        on = not self.state.get("wifi_on")
        in_thread(lambda: Wifi.set_enabled(on), lambda _: self.refresh())

    def toggle_bt(self):
        on = not self.state.get("bt_on")
        in_thread(lambda: Bluetooth.set_powered(on), lambda _: self.refresh())

    def show_detail(self, which):
        self.open_detail = None if self.open_detail == which else which
        self.password_for = None
        for name, chev in (("wifi", self.wifi), ("bt", self.bt)):
            chev.set_open(self.open_detail == name)
        self.sound_chevron.set_label(ICON_CHEVRON_OPEN if self.open_detail == "sound" else ICON_CHEVRON)
        if self.open_detail:
            self.render_detail()
            if self.open_detail == "wifi" and self.state.get("wifi_on"):
                in_thread(lambda: Wifi.networks(rescan=True), lambda nets: self._set_nets(nets))
        self.revealer.set_reveal_child(bool(self.open_detail))

    def _set_nets(self, nets):
        self.state["wifi_nets"] = nets
        if self.open_detail == "wifi":
            self.render_detail()

    # ----- detail lists

    def head(self, title, button=None):
        box = Gtk.Box()
        box.add_css_class("detail-head")
        box.append(label(title, "section", hexpand=True))
        if button:
            box.append(button)
        self.detail.append(box)

    def row(self, name, meta="", highlight=False, on_click=None, trailing=""):
        btn = Gtk.Button()
        btn.add_css_class("row")
        box = Gtk.Box(spacing=8)
        n = label(name, "name", hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        if highlight:
            n.add_css_class("highlight")
        box.append(n)
        if meta:
            box.append(label(meta, "meta"))
        if trailing:
            box.append(label(trailing, "meta"))
        btn.set_child(box)
        if on_click:
            btn.connect("clicked", lambda *_: on_click())
        self.detail.append(btn)

    def render_detail(self):
        clear(self.detail)
        s = self.state
        if self.open_detail == "wifi":
            self.head("Wi-Fi 네트워크")
            if not s.get("wifi_dev"):
                self.row("Wi-Fi 장치가 없습니다", meta="")
            elif not s.get("wifi_on"):
                self.row("Wi-Fi가 꺼져 있습니다")
            elif not s.get("wifi_nets"):
                self.row("네트워크 검색 중…")
            for n in s.get("wifi_nets", [])[:10]:
                icon = SIGNAL[min(n["signal"] // 21, 4)]
                meta = (ICON_LOCK + " " if n["secure"] else "") + icon
                self.row(n["ssid"], meta=meta, highlight=n["active"],
                         trailing=ICON_CHECK if n["active"] else "",
                         on_click=None if n["active"] else (lambda n=n: self.pick_network(n)))
                if self.password_for == n["ssid"]:
                    self.password_row(n["ssid"])
        elif self.open_detail == "bt":
            scan = Gtk.Button(label="검색 중…" if self.bt_scanning else "다른 기기 찾기")
            scan.add_css_class("small-btn")
            scan.set_sensitive(s.get("bt_on", False) and not self.bt_scanning)
            scan.connect("clicked", lambda *_: self.scan_bt())
            self.head("기기", scan)
            if not s.get("bt_ok"):
                self.row("Bluetooth 장치가 없습니다")
            elif not s.get("bt_on"):
                self.row("Bluetooth가 꺼져 있습니다")
            for d in s.get("bt_devs", []):
                self.row(d["name"], meta="연결됨" if d["connected"] else "", highlight=d["connected"],
                         on_click=lambda d=d: self.bt_toggle_device(d))
            if self.bt_found:
                self.head("새 기기")
                for d in self.bt_found:
                    self.row(d["name"], meta="연결", on_click=lambda d=d: self.bt_pair(d))
        elif self.open_detail == "sound":
            self.head("출력")
            for o in s.get("outputs", []):
                self.row(o["label"], highlight=o["active"], trailing=ICON_CHECK if o["active"] else "",
                         on_click=None if o["active"] else
                         (lambda o=o: in_thread(lambda: Sound.set_output(o["name"]), lambda _: self.refresh())))

    # ----- actions

    def pick_network(self, net):
        if net["secure"] and net["ssid"] not in Wifi.known():
            self.password_for = net["ssid"]
            self.render_detail()
            return
        self.connect_wifi(net["ssid"])

    def password_row(self, ssid):
        box = Gtk.Box(spacing=6)
        box.add_css_class("detail-head")
        entry = Gtk.PasswordEntry(hexpand=True, show_peek_icon=True)
        go = Gtk.Button(label="연결")
        go.add_css_class("small-btn")
        submit = lambda *_: self.connect_wifi(ssid, entry.get_text()) if entry.get_text() else None
        entry.connect("activate", submit)
        go.connect("clicked", submit)
        box.append(entry)
        box.append(go)
        self.detail.append(box)
        GLib.idle_add(entry.grab_focus)

    def connect_wifi(self, ssid, password=None):
        self.password_for = None
        self.wifi.update(True, ICON_WIFI, f"{ssid} 연결 중…")
        def done(ok):
            if not ok:
                self.wifi.update(True, ICON_WIFI, "연결 실패")
            self.refresh()
        in_thread(lambda: Wifi.connect(ssid, password), done)

    def bt_toggle_device(self, d):
        self.bt.update(True, ICON_BT, f"{d['name']} {'해제' if d['connected'] else '연결'} 중…")
        in_thread(lambda: Bluetooth.set_connected(d["mac"], not d["connected"]), lambda _: self.refresh())

    def scan_bt(self):
        self.bt_scanning = True
        self.render_detail()
        def done(found):
            self.bt_scanning = False
            self.bt_found = found
            self.render_detail()
        in_thread(Bluetooth.discover, done)

    def bt_pair(self, d):
        self.bt.update(True, ICON_BT, f"{d['name']} 연결 중…")
        def done(ok):
            self.bt_found = [x for x in self.bt_found if x["mac"] != d["mac"]] if ok else self.bt_found
            self.refresh()
        in_thread(lambda: Bluetooth.pair(d["mac"]), done)


if __name__ == "__main__":
    ControlCenter().run([])
