#!/usr/bin/env python3
# Waybar clock pill: the time, and under it three short lines  _ _ _  for
# CPU, GPU and RAM load. Each line is always the same length; only its color
# shows the load: gray (idle) -> light gray -> peach -> red (busy).
# Prints one JSON line per second for a waybar custom module.
import glob, json, os, sys, time

# (upper bound %, color): Claude grays, then Catppuccin Mocha peach / red
LEVELS = [(30, "#4a4a47"), (60, "#9c9a92"), (85, "#fab387"), (101, "#f38ba8")]
UNITS = 2   # length of each line, in "▄" characters

def cpu_times():
    with open("/proc/stat") as f:
        v = list(map(int, f.readline().split()[1:]))
    idle = v[3] + v[4]
    return idle, sum(v)

def ram():
    m = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, val = line.split(":")
            m[k] = int(val.split()[0])
    return 100 * (1 - m["MemAvailable"] / m["MemTotal"])

def gpu_path():
    # the GPU with the most VRAM (the graphics card, not the CPU's built-in one)
    best, size = None, -1
    for card in glob.glob("/sys/class/drm/card[0-9]*/device"):
        try:
            v = int(open(card + "/mem_info_vram_total").read())
        except OSError:
            continue
        if v > size and os.path.exists(card + "/gpu_busy_percent"):
            best, size = card + "/gpu_busy_percent", v
    return best

def gpu(path):
    try:
        return float(open(path).read())
    except (OSError, ValueError, TypeError):
        return 0.0

def meter(pct):
    color = next(c for top, c in LEVELS if pct < top)
    return f"<span color='{color}'>" + "▄" * UNITS + "</span>"

def main():
    gp = gpu_path()
    prev = cpu_times()
    gpu_avg = 0.0
    while True:
        time.sleep(1)
        cur = cpu_times()
        di, dt = cur[0] - prev[0], cur[1] - prev[1]
        prev = cur
        c = 100 * (1 - di / dt) if dt else 0
        # gpu_busy_percent jumps around frame to frame; smooth it a little
        gpu_avg = 0.5 * gpu_avg + 0.5 * gpu(gp)
        r = ram()
        bars = "<span size='5.3pt'>" + "  ".join(meter(p) for p in (c, gpu_avg, r)) + "</span>"
        text = (f"<span size='13.5pt' line_height='0.2'>{time.strftime('%H:%M')}</span>\n{bars}")
        out = {
            "text": text,
            "tooltip": f"CPU {c:.0f}%   GPU {gpu_avg:.0f}%   RAM {r:.0f}%",
        }
        print(json.dumps(out, ensure_ascii=False), flush=True)

if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)
