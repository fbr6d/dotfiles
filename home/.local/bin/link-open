#!/usr/bin/env python3
"""link-open URL...: default handler for http/https links (2026-11-22, master request).

PDF links (path ends in .pdf, e.g. Discord attachments) are downloaded to ~/Downloads
and opened in Papers on the current workspace. Everything else goes to Zen as before.
If the download fails or isn't really a PDF, the link goes to Zen too, so a click
never silently does nothing.
Undo: xdg-mime default zen.desktop x-scheme-handler/http x-scheme-handler/https
(backup ~/.local/share/backups/link-open-20261122/mimeapps.list.bak)
"""
import hashlib, json, os, pathlib, subprocess, sys, urllib.parse, urllib.request

BROWSER = ["/opt/zen-browser-bin/zen-bin"]
VIEWER = ["papers"]
DL = pathlib.Path.home() / "Downloads"
LOG = pathlib.Path.home() / ".cache" / "link-open.log"
# already-downloaded PDFs: "host/path" (query dropped: Discord signs links with ?ex=..&hm=..
# that change every time) -> {"file": path, "sha256": hex}. A hit is reused without
# downloading again, as long as the file on disk still has the recorded hash.
INDEX = pathlib.Path.home() / ".cache" / "link-open" / "index.json"


def log(msg):
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as f:
            f.write(msg + "\n")
    except OSError:
        pass


def spawn(cmd):
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def notify(text):
    subprocess.run(["notify-send", "-a", "링크 열기", "-i", "application-pdf", text],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def url_key(url):
    p = urllib.parse.urlsplit(url)
    return p.netloc.lower() + p.path


def load_index():
    try:
        return json.loads(INDEX.read_text())
    except (OSError, ValueError):
        return {}


def save_index(idx):
    INDEX.parent.mkdir(parents=True, exist_ok=True)
    tmp = INDEX.with_suffix(".tmp")
    tmp.write_text(json.dumps(idx, ensure_ascii=False, indent=1))
    tmp.replace(INDEX)


def cached(url):
    """Local file for this link if it was downloaded before and is unchanged."""
    e = load_index().get(url_key(url))
    if e and os.path.isfile(e["file"]) and sha256_file(e["file"]) == e["sha256"]:
        return pathlib.Path(e["file"])
    return None


def remember(url, path, digest):
    idx = load_index()
    idx[url_key(url)] = {"file": str(path), "sha256": digest}
    save_index(idx)


def is_pdf_url(url):
    p = urllib.parse.urlsplit(url)
    return p.scheme in ("http", "https") and p.path.lower().endswith(".pdf")


def fetch_pdf(url):
    hit = cached(url)
    if hit:
        log(f"cache-hit {hit}")
        return hit
    name = urllib.parse.unquote(pathlib.PurePosixPath(urllib.parse.urlsplit(url).path).name)
    name = name.replace("/", "_").strip() or "download.pdf"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 link-open"})
    with urllib.request.urlopen(req, timeout=30) as r:
        data = r.read(200 * 1024 * 1024 + 1)
    if len(data) > 200 * 1024 * 1024 or not data.startswith(b"%PDF"):
        raise ValueError("not a PDF (or too big)")
    DL.mkdir(parents=True, exist_ok=True)
    dest = DL / name
    stem, suf = dest.stem, dest.suffix
    n = 1
    digest = hashlib.sha256(data).hexdigest()
    for e in load_index().values():      # same content saved under another link
        if e["sha256"] == digest and os.path.isfile(e["file"]) and sha256_file(e["file"]) == digest:
            remember(url, e["file"], digest)
            return pathlib.Path(e["file"])
    while dest.exists():
        if sha256_file(dest) == digest:
            remember(url, dest, digest)
            return dest          # same file already downloaded: just open it
        dest = DL / f"{stem} ({n}){suf}"
        n += 1
    tmp = dest.with_name("." + dest.name + ".part")
    tmp.write_bytes(data)
    tmp.rename(dest)
    remember(url, dest, digest)
    return dest


def main():
    for url in sys.argv[1:]:
        if is_pdf_url(url):
            try:
                path = fetch_pdf(url)
                spawn(VIEWER + [str(path)])
                log(f"pdf {path}")
                continue
            except Exception as e:          # fall back to the browser, never drop the click
                log(f"pdf-fail {type(e).__name__}: {e} :: {url[:120]}")
                notify("PDF를 받지 못해서 브라우저로 열게요")
        spawn(BROWSER + [url])
        log(f"web {url[:120]}")


if __name__ == "__main__":
    main()
