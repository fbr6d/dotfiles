#!/usr/bin/env python3
"""html-view FILE...: open local HTML files in a clean Chromium app window
(no tabs or address bar). Used as the default app for .html and by yazi."""
import os, pathlib, subprocess, sys

for arg in sys.argv[1:] or ["."]:
    url = arg if "://" in arg else pathlib.Path(arg).resolve().as_uri()
    subprocess.Popen(["chromium", "--ozone-platform=wayland", f"--app={url}"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
