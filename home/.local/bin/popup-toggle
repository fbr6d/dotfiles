#!/bin/sh
# Bar click handler: open a settings app as a popup, or close it if open.
# Usage: popup-toggle <window-class> <command...>
#        popup-toggle title:<exact window title> <command...>   (apps with no class, e.g. waytrogen)
match="$1"; shift
addr=$(hyprctl clients -j | python3 -c "
import json, sys
m = sys.argv[1]
key, val = ('title', m[6:]) if m.startswith('title:') else ('class', m)
print(next((c['address'] for c in json.load(sys.stdin) if c[key] == val), ''))
" "$match")
if [ -n "$addr" ]; then
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null
else
    exec "$@"
fi
