#!/bin/sh
# The lock screen used as the login screen after the automatic login at boot.
# Same look as the normal lock screen (~/.config/hypr/hyprlock.conf), but:
#  - background = the wallpaper already blurred and darkened by greeter-bg
#    (/var/lib/greeter-bg/background.jpg; at boot there is no desktop to
#    screenshot, and hyprlock's own blur didn't show up on an image there),
#    drawn as it is: no extra blur, full brightness
#  - unlocking: Hyprland doesn't draw the desktop while locked, so fading the
#    lock screen out showed a gray screen. Instead the lock screen goes away at
#    once and an overlay underneath (~/.config/quickshell/login-reveal), showing
#    the same picture, melts the blur into the sharp desktop (1.6 s)
# Returns when unlocked and revealed. If hyprlock can't start, it keeps trying
# (falling back to the normal lock screen): the session must never be left
# unlocked.
CONF=$HOME/.config/hypr/hyprlock.conf
OUT=${XDG_RUNTIME_DIR:-/tmp}/hyprlock-login.conf
BG=/var/lib/greeter-bg/background.jpg
NO_FADE_OUT='s|^\(\s*animation = fadeOut,\).*|\1 0|'

src=$(cat /var/lib/greeter-bg/source 2>/dev/null)
if [ -f "$BG" ]; then
    sed -e "s|^\(\s*path = \)screenshot|\1$BG|" \
        -e 's|^\(\s*blur_passes = \).*|\10|' \
        -e 's|^\(\s*brightness = \).*|\11.0|' \
        -e "$NO_FADE_OUT" "$CONF" > "$OUT"
    # the overlay goes up first and is drawn before the lock screen covers it
    if [ -f "$src" ]; then
        LOGIN_REVEAL_IMAGE="$src" LOGIN_REVEAL_BLURRED="$BG" qs -c login-reveal -n >/dev/null 2>&1 &
        reveal=$!
        sleep 0.6
    fi
else   # no prepared image yet: the plain wallpaper with hyprlock's own blur
    img=$(sed -n 's/^wallpaper = //p' "$HOME/.config/waypaper/config.ini" | sed "s|^~|$HOME|")
    sed -e "s|^\(\s*path = \)screenshot|\1$img|" "$CONF" > "$OUT"
fi

if ! hyprlock --no-fade-in --grace 0 -c "$OUT"; then
    until hyprlock --grace 0; do sleep 1; done
fi

# unlocked: play the reveal and wait for it to finish (at most ~3 s)
if [ -n "$reveal" ]; then
    qs -c login-reveal ipc call reveal start >/dev/null 2>&1 || kill "$reveal" 2>/dev/null
    for _ in $(seq 30); do kill -0 "$reveal" 2>/dev/null || break; sleep 0.1; done
    kill "$reveal" 2>/dev/null
fi
exit 0
