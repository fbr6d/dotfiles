#!/usr/bin/env python3
# Translucent Hyprland keybind cheatsheet. Hyprland window rules (class
# "local.hypr.cheatsheet") keep it floating, pinned on every workspace and out
# of the scrolling layout. Drag it anywhere with the left mouse button.
# Usage: hypr-cheatsheet          start (no-op if already running)
#        hypr-cheatsheet --toggle start, or stop if already running
import json
import os
import signal
import socket
import sys

PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr-cheatsheet.pid")


def running_pid():
    try:
        pid = int(open(PIDFILE).read())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


pid = running_pid()
if pid:
    if "--toggle" in sys.argv:
        os.kill(pid, signal.SIGTERM)
    sys.exit(0)
open(PIDFILE, "w").write(str(os.getpid()))

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import GLib, GLibUnix, Gtk

APP_ID = "local.hypr.cheatsheet"

SECTIONS = [
    ("앱", [
        ("SUPER + Enter", "터미널"),
        ("SUPER + T", "플로팅 터미널"),
        ("SUPER + Space", "런처"),
        ("SUPER + E", "파일 관리자"),
        ("SUPER + B", "Zen 브라우저"),
        ("SUPER + Q", "창 닫기"),
        ("SUPER + CTRL + Q", "잠금"),
        ("SUPER + SHIFT + E", "종료"),
        ("CTRL + ALT + SHIFT + R", "재부팅"),
    ]),
    ("창 (스크롤링)", [
        ("SUPER + ←→ / HL", "옆 칸으로"),
        ("SUPER + ↑↓ / KJ", "칸 안에서 위·아래"),
        ("+ SHIFT", "칸·창 옮기기"),
        ("+ CTRL ←→", "칸 너비 ½ · ⅔ · 전체"),
        ("+ CTRL ↑↓", "높이 조절"),
        ("SUPER + , / .", "옆 칸에 합치기 · 빼기"),
        ("SUPER + C", "가운데로"),
        ("SUPER + F / M", "전체화면 / 최대화"),
        ("SUPER + V", "플로팅"),
        ("SUPER + SHIFT + V", "클립보드 기록"),
        ("SUPER + G / Tab", "그룹 / 다음 탭"),
    ]),
    ("보기", [
        ("ALT + Tab", "창 전환"),
        ("SUPER + I", "리눅스 명령어 사전"),
        ("SUPER + /", "이 창 숨기기"),
    ]),
    ("워크스페이스", [
        ("SUPER + 1‥0", "이동"),
        ("SUPER + SHIFT + 1‥0", "창 보내기"),
        ("SUPER + S", "스크래치패드"),
        ("SUPER + 휠", "앞 / 뒤"),
    ]),
]

# Colors: monochrome dark (Claude grays); Catppuccin Mocha only for highlighted text
CSS = """
window, window.background { background: transparent; }
.sheet {
    background: rgba(38, 38, 36, 0.72);
    border: 1px solid rgba(200, 200, 200, 0.35);
    border-radius: 12px;
    padding: 15px 21px;
    font-family: "Pretendard";
    font-size: 16px;
}
.title   { color: #cba6f7; font-weight: bold; margin-top: 9px; }
.title.first { margin-top: 0; }
.key     { color: #89b4fa; font-family: "D2Coding"; font-size: 14px; }
.desc    { color: #faf9f5; }
"""

HYPR_SOCKET = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr",
                           os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""), ".socket.sock")


def hypr(cmd):
    """Send one request to Hyprland's IPC socket and return the reply."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.connect(HYPR_SOCKET)
        sock.sendall(cmd.encode())
        chunks = []
        while chunk := sock.recv(65536):
            chunks.append(chunk)
    return b"".join(chunks).decode()


class Dragger:
    """Move the window by following the global cursor while button 1 is held.

    Positions come from Hyprland (global cursor and window coords), so the
    window moving under the pointer does not feed back into the drag.
    """

    def __init__(self):
        self.timer = None

    def begin(self, gesture, x, y):
        try:
            me = next(c for c in json.loads(hypr("j/clients")) if c["pid"] == os.getpid())
            cur = json.loads(hypr("j/cursorpos"))
        except (OSError, StopIteration, ValueError):
            return
        self.address = me["address"]
        self.offset = (cur["x"] - me["at"][0], cur["y"] - me["at"][1])
        self.last = None
        self.timer = GLib.timeout_add(16, self.follow)

    def follow(self):
        try:
            cur = json.loads(hypr("j/cursorpos"))
        except (OSError, ValueError):
            return GLib.SOURCE_CONTINUE
        pos = (cur["x"] - self.offset[0], cur["y"] - self.offset[1])
        if pos != self.last:
            self.last = pos
            hypr('dispatch hl.dsp.window.move({ window = "address:%s", x = %d, y = %d })'
                 % (self.address, pos[0], pos[1]))
        return GLib.SOURCE_CONTINUE

    def end(self, gesture, x, y):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
            # Clicking focused the cheatsheet; give focus back
            hypr("dispatch hl.dsp.focus({ last = true })")


def build(app):
    win = Gtk.ApplicationWindow(application=app, title="Hyprland Cheatsheet",
                                decorated=False, resizable=False)

    provider = Gtk.CssProvider()
    provider.load_from_string(CSS)
    Gtk.StyleContext.add_provider_for_display(
        win.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    grid = Gtk.Grid(column_spacing=18, row_spacing=2)
    grid.add_css_class("sheet")
    row = 0
    for i, (title, binds) in enumerate(SECTIONS):
        label = Gtk.Label(label=title, xalign=0)
        label.add_css_class("title")
        if i == 0:
            label.add_css_class("first")
        grid.attach(label, 0, row, 2, 1)
        row += 1
        for key, desc in binds:
            k = Gtk.Label(label=key, xalign=0)
            k.add_css_class("key")
            d = Gtk.Label(label=desc, xalign=0)
            d.add_css_class("desc")
            grid.attach(k, 0, row, 1, 1)
            grid.attach(d, 1, row, 1, 1)
            row += 1

    dragger = Dragger()
    drag = Gtk.GestureDrag(button=1)
    drag.connect("drag-begin", dragger.begin)
    drag.connect("drag-end", dragger.end)
    grid.add_controller(drag)
    win.dragger = dragger

    win.set_child(grid)
    win.present()


def main():
    app = Gtk.Application(application_id=APP_ID)
    app.connect("activate", build)
    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda _: app.quit(), None)
    try:
        app.run([])
    finally:
        if running_pid() == os.getpid():
            os.remove(PIDFILE)


main()
