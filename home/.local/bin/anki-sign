#!/usr/bin/env python3
"""anki-sign: give every sold copy of an Anki deck (.apkg) its own hidden,
obfuscated signature, and find out whose copy a leaked file came from.

  anki-sign DECK.apkg 구매자아이디         # same as "make": writes DECK_구매자아이디.apkg
  anki-sign make   DECK.apkg 구매자아이디 [--order 주문번호] [-o OUT.apkg] [--no-visible]
  anki-sign detect FILE              # whose copy is this? (.apkg or any text file)
  anki-sign check  FILE 구매자아이디  # is this that buyer's copy? (works without the ledger)
  anki-sign list                     # copies made so far (numbered)
  anki-sign remove 번호|아이디|코드 ... [--files] [-y]
                                     # delete from the list (--files: move the made files to trash too)

The signature is a 32-bit code derived from the buyer ID with the key, plus a 16-bit check value (48 bits),
XOR-masked with a key only you have, so it looks like noise and can't be forged
or read without the key. It is hidden three independent ways, so removing one
still leaves the others:
  A. invisible zero-width characters inside the Tip field of 40 cards
     (survive copy-paste of the card text, export to CSV, re-import ...)
  B. a trailing space / no trailing space on the Tip field of 96 other cards
  C. the lowest bit of the "modified" time of 96 other cards
Which cards carry it is decided by the key too, so it's the same cards in every
copy (that's how detect finds it) but nobody else can tell which.
Optionally (default on) the deck description also says who bought it.

Key:    ~/.config/anki-sign/secret   (made on first run; BACK IT UP — without it
                                       no signature can be read again)
Ledger: ~/.local/share/anki-sign/ledger.csv  (code → buyer, order, date, file)
"""
import argparse, csv, datetime, hashlib, hmac, json, os, re, secrets, shutil
import sqlite3, sys, tempfile, zipfile
from collections import Counter

CONF = os.path.expanduser("~/.config/anki-sign")
DATA = os.path.expanduser("~/.local/share/anki-sign")
SECRET = os.path.join(CONF, "secret")
LEDGER = os.path.join(DATA, "ledger.csv")
ZW0, ZW1, ZW_START, ZW_END = "​", "‌", "⁣", "⁤"
ZW_RE = re.compile(f"{ZW_START}([{ZW0}{ZW1}]{{48}}){ZW_END}")
N_ZW, N_SP, N_MOD = 40, 96, 96
LEDGER_COLS = ["code", "buyer", "order", "date", "source", "output", "sha256"]


# ---------- key / crypto ----------
def key():
    if not os.path.exists(SECRET):
        os.makedirs(CONF, exist_ok=True)
        with open(SECRET, "w") as f:
            f.write(secrets.token_hex(32))
        os.chmod(SECRET, 0o600)
        print(f"새 비밀 키를 만들었습니다: {SECRET}  (꼭 따로 백업하세요)")
    return bytes.fromhex(open(SECRET).read().strip())


def prf(k, label, n=32):
    out, i = b"", 0
    while len(out) < n:
        out += hmac.new(k, f"{label}|{i}".encode(), hashlib.sha256).digest()
        i += 1
    return out[:n]


def code_of(k, buyer):
    """Buyer ID → 32-bit code (same ID → same code; unguessable without the key)."""
    return int.from_bytes(prf(k, f"buyer|{buyer.strip()}", 4), "big")


def encode(k, code):
    """32-bit code → 48 masked bits."""
    check = int.from_bytes(prf(k, f"check|{code}", 2), "big")
    raw = (code << 16) | check
    mask = int.from_bytes(prf(k, "mask", 6), "big")
    v = raw ^ mask
    return [(v >> (47 - i)) & 1 for i in range(48)]


def decode(k, bits):
    """48 bits → code, or None when the check value doesn't match."""
    v = 0
    for b in bits:
        v = (v << 1) | b
    raw = v ^ int.from_bytes(prf(k, "mask", 6), "big")
    code, check = raw >> 16, raw & 0xFFFF
    return code if int.from_bytes(prf(k, f"check|{code}", 2), "big") == check else None


# ---------- deck access ----------
def open_apkg(path, workdir):
    """Unpack; return the real collection's sqlite path and the zip's file list.
    New-style packages (Anki's default export) keep it zstd-compressed in
    collection.anki21b, next to a dummy collection.anki2 for old Anki versions."""
    with zipfile.ZipFile(path) as z:
        z.extractall(workdir)
        names = z.namelist()
    if "collection.anki21b" in names:
        from compression import zstd  # Python 3.14+
        raw = os.path.join(workdir, "collection.anki21b")
        db = raw + ".sqlite"
        with open(raw, "rb") as f, open(db, "wb") as g:
            g.write(zstd.decompress(f.read()))
        return db, names
    for n in ("collection.anki21", "collection.anki2"):
        if n in names:
            return os.path.join(workdir, n), names
    sys.exit("Anki 덱 파일(.apkg)이 아닙니다.")


def repack(workdir, colpath, names, out):
    if colpath.endswith(".anki21b.sqlite"):
        from compression import zstd
        with open(colpath, "rb") as f, open(colpath[:-len(".sqlite")], "wb") as g:
            g.write(zstd.compress(f.read()))
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        for n in names:
            z.write(os.path.join(workdir, n), n)


def tip_index(db):
    """model id → index of the field that carries signatures (Tip, else 2nd-to-last)."""
    models = json.loads(db.execute("select models from col").fetchone()[0] or "{}")
    idx = {}
    if not models:  # new schema: note types live in their own tables
        names = {}
        db.create_collation("unicase", lambda x, y: (x.lower() > y.lower()) - (x.lower() < y.lower()))
        for ntid, ord_, name in sorted(db.execute("select ntid, ord, name from fields")):
            names.setdefault(ntid, []).append(name)
        for ntid, ns in names.items():
            idx[ntid] = ns.index("Tip") if "Tip" in ns else max(0, len(ns) - 2)
        return idx
    for mid, m in models.items():
        names = [f["name"] for f in m["flds"]]
        idx[int(mid)] = names.index("Tip") if "Tip" in names else max(0, len(names) - 2)
    return idx


def carriers(k, db):
    """The same three disjoint card sets in every copy, chosen by the key."""
    idx = tip_index(db)
    notes = db.execute("select id, guid, mid, flds from notes").fetchall()
    pool = [(nid, guid) for nid, guid, mid, flds in notes
            if flds.split("\x1f")[idx[mid]].strip(" " + ZW0 + ZW1 + ZW_START + ZW_END)]
    rank = lambda tag: sorted(pool, key=lambda p: prf(k, f"{tag}|{p[1]}", 8))
    zw = [p[0] for p in rank("zw")[:N_ZW]]
    rest = [p for p in rank("sp") if p[0] not in set(zw)]
    sp = [p[0] for p in rest[:N_SP]]
    used = set(zw) | set(sp)
    mod = [nid for nid, guid in sorted(((n[0], n[1]) for n in notes), key=lambda p: prf(k, f"mod|{p[1]}", 8))
           if nid not in used][:N_MOD]
    return idx, zw, sp, mod


def text_positions(s):
    """Indices where a character may be inserted without landing inside an HTML tag/entity."""
    out, in_tag, in_ent = [], False, False
    for i, ch in enumerate(s):
        if not in_tag and not in_ent and i > 0:
            out.append(i)
        if ch == "<":
            in_tag = True
        elif ch == ">" and in_tag:
            in_tag = False
        elif ch == "&" and not in_tag:
            in_ent = True
        elif ch == ";" and in_ent:
            in_ent = False
    return out or [len(s)]


# ---------- make ----------
def make(a):
    k = key()
    os.makedirs(DATA, exist_ok=True)
    if a.buyer.strip() in ("make", "detect", "check", "list", "remove"):
        sys.exit(f"'{a.buyer}'는 명령 이름이라 구매자 아이디로 쓸 수 없습니다. "
                 f"검출하려면: anki-sign detect {a.deck}")
    code = code_of(k, a.buyer)
    clash = [r["buyer"] for r in read_ledger() if r["code"] == f"{code:08x}" and r["buyer"] != a.buyer.strip()]
    if clash:
        sys.exit(f"아이디 '{a.buyer}'의 코드가 '{clash[0]}'와 겹칩니다 (아주 드문 경우). 아이디에 글자를 덧붙여 주세요.")
    bits = encode(k, code)
    out = a.output or re.sub(r"\.apkg$", "", a.deck) + "_" + re.sub(r"[^\w.-]", "_", a.buyer.strip()) + ".apkg"

    with tempfile.TemporaryDirectory() as tmp:
        colpath, names = open_apkg(a.deck, tmp)
        db = sqlite3.connect(colpath)
        idx, zw, sp, mod = carriers(k, db)
        if len(zw) < N_ZW or len(sp) < 48:
            sys.exit("카드 수가 너무 적어 시그니처를 넣을 수 없습니다 (Tip이 있는 카드 150장 이상 필요).")
        payload = ZW_START + "".join(ZW1 if b else ZW0 for b in bits) + ZW_END
        row = lambda nid: db.execute("select mid, flds from notes where id=?", (nid,)).fetchone()
        for nid in zw:                                       # A
            mid, flds = row(nid)
            f = flds.split("\x1f"); t = ZW_RE.sub("", f[idx[mid]])  # drop an older signature
            pos = text_positions(t)
            p = pos[int.from_bytes(prf(k, f"pos|{nid}", 4), "big") % len(pos)]
            f[idx[mid]] = t[:p] + payload + t[p:]
            db.execute("update notes set flds=? where id=?", ("\x1f".join(f), nid))
        for i, nid in enumerate(sp):                         # B
            mid, flds = row(nid)
            f = flds.split("\x1f")
            f[idx[mid]] = f[idx[mid]].rstrip(" ") + (" " if bits[i % 48] else "")
            db.execute("update notes set flds=? where id=?", ("\x1f".join(f), nid))
        for i, nid in enumerate(mod):                        # C
            db.execute("update notes set mod=(mod & ~1) | ? where id=?", (bits[i % 48], nid))
        decks = json.loads(db.execute("select decks from col").fetchone()[0] or "{}")
        if not decks:
            print("주의: 원본이 새 압축 형식(Anki 2.1.50 이상 전용)이라 결과도 같은 형식입니다. 아주 오래된 "
                  "Anki에서는 안 열릴 수 있고, 덱 설명에 구매자 표시도 넣지 못했습니다(숨은 시그니처는 들어감). "
                  "어디서나 열리게 하려면 Anki에서 '이전 Anki 버전과 호환' 옵션을 켜고 다시 내보낸 파일을 쓰세요.")
        if not a.no_visible and decks:
            note = f"<br><small>구매자 {a.buyer.strip()} 전용{' · 주문 ' + a.order if a.order else ''} · 재배포·재판매 금지</small>"
            for d in decks.values():
                if d["name"] != "Default":
                    d["desc"] = (d.get("desc") or "") + note
            db.execute("update col set decks=?", (json.dumps(decks, ensure_ascii=False),))
        db.commit(); db.close()
        repack(tmp, colpath, names, out)

    sha = hashlib.sha256(open(out, "rb").read()).hexdigest()
    new = not os.path.exists(LEDGER)
    with open(LEDGER, "a", newline="") as f:
        w = csv.writer(f)
        if new:
            w.writerow(LEDGER_COLS)
        w.writerow([f"{code:08x}", a.buyer.strip(), a.order or "", datetime.datetime.now().isoformat(timespec="seconds"),
                    os.path.abspath(a.deck), os.path.abspath(out), sha])
    print(f"완료: {out}\n구매자 {a.buyer.strip()} → 코드 {code:08x} 를 장부에 기록했습니다 ({LEDGER}).")


# ---------- detect ----------
def read_ledger():
    if not os.path.exists(LEDGER):
        return []
    with open(LEDGER, newline="") as f:
        return list(csv.DictReader(f))


def vote(cands):
    """bit lists (may contain None) → majority bits, or None."""
    if not cands:
        return None
    out = []
    for i in range(48):
        c = Counter(b[i] for b in cands if b[i] is not None)
        if not c:
            return None
        out.append(c.most_common(1)[0][0])
    return out


def signatures(k, path):
    """method name → code found in the file (None when missing or damaged)."""
    found = {}
    a = argparse.Namespace(file=path)
    if a.file.endswith(".apkg"):
        with tempfile.TemporaryDirectory() as tmp:
            colpath, _ = open_apkg(a.file, tmp)
            db = sqlite3.connect(colpath)
            idx, zw, sp, mod = carriers(k, db)
            get = lambda nid: db.execute("select mid, flds, mod from notes where id=?", (nid,)).fetchone()
            zw_bits = [[1 if c == ZW1 else 0 for c in m] for nid in zw if get(nid)
                       for m in ZW_RE.findall(get(nid)[1])]
            sp_bits = [[None] * 48 for _ in range(2)]
            for i, nid in enumerate(sp):
                r = get(nid)
                if r:
                    sp_bits[i // 48][i % 48] = 1 if r[1].split("\x1f")[idx[r[0]]].endswith(" ") else 0
            md_bits = [[None] * 48 for _ in range(2)]
            for i, nid in enumerate(mod):
                r = get(nid)
                if r:
                    md_bits[i // 48][i % 48] = r[2] & 1
            for name, cands in (("A 보이지 않는 문자", zw_bits), ("B 끝 공백", sp_bits), ("C 수정 시각", md_bits)):
                b = vote(cands)
                found[name] = decode(k, b) if b else None
    else:  # plain text: only the zero-width signature can survive
        text = open(a.file, encoding="utf-8", errors="ignore").read()
        cands = [[1 if c == ZW1 else 0 for c in m] for m in ZW_RE.findall(text)]
        b = vote(cands)
        found["A 보이지 않는 문자"] = decode(k, b) if b else None
    return found


def detect(a):
    k = key()
    found = signatures(k, a.file)
    ledger = {r["code"]: r for r in read_ledger()}
    codes = Counter(c for c in found.values() if c is not None)
    for name, c in found.items():
        print(f"  {name:12s}: {f'{c:08x}' if c is not None else '없음/손상'}")
    if not codes:
        print("시그니처를 찾지 못했습니다 (서명하지 않은 파일이거나, 다른 키로 서명했거나, 모두 지워짐).")
        return 1
    code = codes.most_common(1)[0][0]
    r = ledger.get(f"{code:08x}")
    if r:
        print(f"→ 구매자 {r['buyer']} 의 구매본 (주문 {r['order'] or '-'}, {r['date']})")
    else:
        print(f"→ 코드 {code:08x}: 장부에 없는 코드입니다 (장부가 지워졌거나 다른 컴퓨터에서 만든 파일).")
    if len(codes) > 1:
        print("주의: 방법마다 다른 코드가 나왔습니다. 여러 구매본을 섞었을 수 있습니다.")
    return 0


def check(a):
    k = key()
    want = code_of(k, a.buyer)
    found = signatures(k, a.file)
    hits = [n for n, c in found.items() if c == want]
    others = {c for c in found.values() if c is not None and c != want}
    for n, c in found.items():
        print(f"  {n:12s}: {'일치' if c == want else ('다른 코드' if c is not None else '없음/손상')}")
    if hits:
        print(f"→ 예: 구매자 {a.buyer.strip()} 의 구매본입니다 ({len(hits)}/{len(found)}개 방법 일치).")
        return 0
    print(f"→ 아니오: 구매자 {a.buyer.strip()} 의 시그니처가 없습니다" + (" (다른 구매자의 시그니처가 있음)." if others else "."))
    return 1


def list_(a):
    rows = read_ledger()
    if not rows:
        print("아직 만든 구매본이 없습니다.")
        return 0
    print(f"장부: {LEDGER}")
    print(f"{'번호':>4}  {'코드':8}  {'날짜':19}  {'구매자 아이디':20}  {'주문':10}  파일")
    for i, r in enumerate(rows, 1):
        print(f"{i:>4}  {r['code']:8}  {r['date']:19}  {r['buyer']:20}  {r['order'] or '-':10}  {os.path.basename(r['output'])}")
    return 0


def write_ledger(rows):
    with open(LEDGER, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=LEDGER_COLS)
        w.writeheader()
        w.writerows(rows)


def remove(a):
    rows = read_ledger()
    pick = set()
    for q in a.targets:
        hit = {i for i, r in enumerate(rows) if q in (r["buyer"], r["code"])}
        if not hit and q.isdigit() and 1 <= int(q) <= len(rows):
            hit = {int(q) - 1}
        if not hit:
            print(f"'{q}': 목록에 없습니다 (anki-sign list 로 번호·아이디를 확인하세요).")
        pick |= hit
    if not pick:
        return 1
    print("지울 항목:")
    for i in sorted(pick):
        r = rows[i]
        print(f"  {i + 1:>3}. {r['buyer']}  ({r['code']}, {r['date']})  {os.path.basename(r['output'])}")
    if a.files:
        print("만든 파일도 휴지통으로 옮깁니다.")
    if not a.yes and input("지울까요? [y/N] ").strip().lower() not in ("y", "yes", "ㅛ"):
        print("취소했습니다.")
        return 1
    shutil.copy2(LEDGER, LEDGER + ".bak")
    if a.files:
        import subprocess
        for i in sorted(pick):
            out = rows[i]["output"]
            if os.path.exists(out) and out not in {r["output"] for j, r in enumerate(rows) if j not in pick}:
                subprocess.run(["gio", "trash", out]) if shutil.which("gio") else os.remove(out)
    write_ledger([r for i, r in enumerate(rows) if i not in pick])
    print(f"{len(pick)}개 지웠습니다. (되돌리기: {LEDGER}.bak)")
    if not a.files:
        print("만든 .apkg 파일은 그대로 있습니다. 같이 지우려면 --files 를 붙이세요.")
    return 0


def main():
    p = argparse.ArgumentParser(prog="anki-sign", description="Anki 덱 구매자별 숨은 시그니처")
    s = p.add_subparsers(dest="cmd", required=True)
    m = s.add_parser("make", help="구매자 전용 사본 만들기")
    m.add_argument("deck"); m.add_argument("buyer", help="구매자 아이디 (판매 플랫폼 아이디 등)"); m.add_argument("--order")
    m.add_argument("-o", "--output"); m.add_argument("--no-visible", action="store_true",
                                                     help="덱 설명에 구매자 표시를 넣지 않음")
    d = s.add_parser("detect", help="유출된 파일이 누구 것인지 찾기"); d.add_argument("file")
    c = s.add_parser("check", help="이 파일이 특정 구매자 것인지 확인"); c.add_argument("file"); c.add_argument("buyer")
    s.add_parser("list", help="만든 구매본 목록")
    r = s.add_parser("remove", help="목록에서 지우기")
    r.add_argument("targets", nargs="+", metavar="번호|아이디|코드")
    r.add_argument("--files", action="store_true", help="만든 .apkg 파일도 휴지통으로")
    r.add_argument("-y", "--yes", action="store_true", help="확인 없이 지우기")
    argv = sys.argv[1:]
    cmds = ("make", "detect", "check", "list", "remove")
    if len(argv) >= 2 and argv[0] not in cmds and argv[1] in ("detect", "check"):
        argv = [argv[1], argv[0]] + argv[2:]   # "anki-sign FILE detect" / "anki-sign FILE check ID"
    elif len(argv) >= 2 and argv[0].endswith(".apkg") and argv[0] not in cmds:
        argv = ["make"] + argv                  # shorthand: anki-sign DECK.apkg ID
    a = p.parse_args(argv)
    sys.exit({"make": make, "detect": detect, "check": check, "list": list_, "remove": remove}[a.cmd](a))


if __name__ == "__main__":
    main()
