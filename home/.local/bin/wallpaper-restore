#!/bin/sh
# At login: put back the wallpaper the login screen was made from
# (/var/lib/greeter-bg/source = "<last image> <WxH>"), so the desktop under the
# lock screen is the same picture, then start the slideshow.
# Wallpaper picker is waytrogen (2026-11-19, replaced waypaper); the slideshow is
# ~/.local/bin/wallpaper-slideshow (not `waytrogen --restore/--random`: those
# pkill -9 awww-daemon every time). Its first change comes after one interval.
SLIDESHOW=on          # on / off
INTERVAL_MIN=10       # minutes between changes
CFG=$HOME/.config/waytrogen/config.json

img=$(cat /var/lib/greeter-bg/source 2>/dev/null); img=${img% *}
[ -f "$img" ] || img=$(jq -r '.saved_wallpapers[0].path // empty' "$CFG" 2>/dev/null)

for _ in $(seq 50); do awww query >/dev/null 2>&1 && break; sleep 0.1; done   # wait for awww-daemon
[ -f "$img" ] && awww img "$img" --transition-type none --resize crop --fill-color 262624

if [ "$SLIDESHOW" = on ]; then
    exec "$HOME/.local/bin/wallpaper-slideshow" loop "$INTERVAL_MIN"
fi
