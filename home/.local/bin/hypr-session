#!/usr/bin/env python3
# Save and restore open Hyprland windows (app, workspace, position, size).
#   hypr-session save      snapshot windows; written to disk only once the
#                          snapshot is unchanged since the previous save, so
#                          the half-closed state during shutdown is not kept
#   hypr-session save --now   write the snapshot immediately (used before logout)
#   hypr-session restore   relaunch saved apps in their original order, then
#                          put each window back on its workspace, position and size
#   hypr-session show      print the saved session
import json
import os
import shlex
import socket
import sys
import time

STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "hypr-session")
SESSION = os.path.join(STATE_DIR, "session.json")
PENDING = os.path.join(STATE_DIR, "pending.json")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
RESTORING = os.path.join(RUNTIME, "hypr-session.restoring")
HYPR_SOCKET = os.path.join(RUNTIME, "hypr", os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""), ".socket.sock")

# Windows that are started by Hyprland itself or are not real apps
SKIP_CLASSES = {"local.hypr.cheatsheet", "local.mono.greeter", ""}
TERMINALS = {"kitty"}


def hypr(cmd):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.connect(HYPR_SOCKET)
        sock.sendall(cmd.encode())
        chunks = []
        while chunk := sock.recv(65536):
            chunks.append(chunk)
    return b"".join(chunks).decode()


def dispatch(lua):
    return hypr("dispatch " + lua)


def clients():
    return [c for c in json.loads(hypr("j/clients")) if c["mapped"]]


def proc_cmdline(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return None
    # Some apps (Electron) rewrite their cmdline into one space-joined string
    if len(argv) == 1 and " " in argv[0] and not os.path.exists(argv[0]):
        argv = shlex.split(argv[0])
    return argv


def shell_cwd(pid):
    """Working directory of a terminal's first child (its shell)."""
    try:
        with open(f"/proc/{pid}/task/{pid}/children") as f:
            children = f.read().split()
        return os.readlink(f"/proc/{children[0]}/cwd") if children else None
    except (OSError, IndexError):
        return None


def snapshot():
    windows, seen_pids = [], set()
    for c in sorted(clients(), key=lambda c: int(c["stableId"], 16)):
        if c["class"] in SKIP_CLASSES:
            continue
        argv = proc_cmdline(c["pid"])
        if not argv:
            continue
        if c["class"] in TERMINALS:
            cwd = shell_cwd(c["pid"])
            if cwd:
                argv = [argv[0], "--directory", cwd]
        elif c["pid"] in seen_pids:
            continue  # extra window of a single-process app; relaunching once is enough
        seen_pids.add(c["pid"])
        windows.append({
            "class": c["class"],
            "argv": argv,
            "workspace": c["workspace"]["name"],
            "floating": c["floating"],
            "pinned": c["pinned"],
            "fullscreen": c["fullscreen"],
            "at": c["at"],
            "size": c["size"],
        })
    active = json.loads(hypr("j/activeworkspace")).get("name", "1")
    return {"active_workspace": active, "windows": windows}


def write_json(path, data):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save(now=False):
    if os.path.exists(RESTORING):
        return
    snap = snapshot()
    if now or read_json(PENDING) == snap:
        write_json(SESSION, snap)
    write_json(PENDING, snap)


def lua_str(s):
    return "[==[" + s + "]==]"


def wait_for_new_window(known, timeout=20):
    deadline = time.time() + timeout
    while time.time() < deadline:
        for c in clients():
            if c["address"] not in known and c["class"] not in SKIP_CLASSES:
                return c
        time.sleep(0.2)
    return None


def restore():
    session = read_json(SESSION)
    if not session or not session["windows"]:
        return
    open(RESTORING, "w").close()
    try:
        placed = []
        known = {c["address"] for c in clients()}
        # Open tiled windows workspace by workspace, in original order, with focus
        # on the newest one, so dwindle rebuilds the same split tree.
        for w in session["windows"]:
            ws = w["workspace"]
            special = ws.startswith("special:")
            if not special and not w["floating"]:
                dispatch("hl.dsp.focus({ workspace = %s })" % lua_str(ws))
                # dwindle picks the split side from the cursor: aim at the old spot
                dispatch("hl.dsp.cursor.move({ x = %d, y = %d })"
                         % (w["at"][0] + w["size"][0] // 2, w["at"][1] + w["size"][1] // 2))
            rules = ["workspace = %s" % lua_str(ws + (" silent" if special else ""))]
            if w["floating"]:
                rules += ["float = true",
                          "move = %s" % lua_str("%d %d" % tuple(w["at"])),
                          "size = %s" % lua_str("%d %d" % tuple(w["size"]))]
                if w["pinned"]:
                    rules.append("pin = true")
            cmd = shlex.join(w["argv"])
            dispatch("hl.dsp.exec_cmd(%s, { %s })" % (lua_str(cmd), ", ".join(rules)))
            win = wait_for_new_window(known)
            if win:
                known.add(win["address"])
                placed.append((w, win["address"]))

        # Fine-tune tiled sizes (dwindle adjusts split ratios on resize); two passes
        # because each resize also changes the neighbouring windows.
        for _ in range(2):
            for w, addr in placed:
                if not w["floating"]:
                    dispatch("hl.dsp.window.resize({ window = %s, x = %d, y = %d })"
                             % (lua_str("address:" + addr), w["size"][0], w["size"][1]))
            time.sleep(0.3)

        for w, addr in placed:
            if w["fullscreen"]:
                mode = "fullscreen" if w["fullscreen"] == 2 else "maximized"
                dispatch("hl.dsp.window.fullscreen({ window = %s, mode = %s, action = \"set\" })"
                         % (lua_str("address:" + addr), lua_str(mode)))
        dispatch("hl.dsp.focus({ workspace = %s })" % lua_str(session["active_workspace"]))
    finally:
        os.remove(RESTORING)


def show():
    print(json.dumps(read_json(SESSION), ensure_ascii=False, indent=1))


if __name__ == "__main__":
    action = {"save": save, "restore": restore, "show": show}.get(sys.argv[1] if len(sys.argv) > 1 else "")
    if not action:
        sys.exit("usage: hypr-session save [--now]|restore|show")
    if action is save:
        save(now="--now" in sys.argv)
    else:
        action()
