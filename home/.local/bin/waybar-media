#!/usr/bin/env python3
# Waybar custom module for one Spotify control button (prev | play | next).
# Prints one JSON line per player change; empty text hides the button, so the
# control pill only appears while Spotify has a track loaded.
#   waybar-media prev|play|next
import html
import json
import subprocess
import sys

# The icons are SVG files drawn by CSS (~/.config/waybar/icons, style.css), so
# they sit exactly in the middle of the pill; the text is only a space that
# keeps the button visible. "class" picks the icon: playing -> pause icon,
# paused -> play icon.
role = sys.argv[1] if len(sys.argv) > 1 else "play"

proc = subprocess.Popen(
    ["playerctl", "--player=spotify", "--follow", "metadata", "--format",
     "{{status}}\t{{artist}} - {{title}}"],
    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)


def emit(text, tooltip="", cls=""):
    print(json.dumps({"text": text, "tooltip": tooltip, "class": cls}, ensure_ascii=False), flush=True)


emit("")  # hidden until Spotify reports a track
for line in proc.stdout:
    status, _, track = line.rstrip("\n").partition("\t")
    if status not in ("Playing", "Paused"):
        emit("")
        continue
    emit(" ", html.escape(track), status.lower())   # titles may contain & or <
