#!/bin/bash
# Greeting window (kitty --class miku-greeter): Miku pixel art + a greeting written by
# Hermes (miku-engineer, quiet one-shot). Enter resumes that conversation in Hermes,
# any other key drops to a fish shell. Art: ~/.local/share/miku-engineer/miku.ans
ART="$HOME/.local/share/miku-engineer/miku.ans"
HERMES="$HOME/.local/bin/miku-engineer"
SKILL=miku-boot-greeting   # greeting instructions live in this skill (system prompt), not the chat log

clear
echo
[ -f "$ART" ] && sed 's/^/  /' "$ART"
echo

out=$(mktemp); err=$(mktemp)
"$HERMES" chat -Q -s "$SKILL" -q "…" >"$out" 2>"$err" &
pid=$!
frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'; i=0
while kill -0 "$pid" 2>/dev/null; do
    printf '\r  \033[38;2;57;197;187m%s\033[0m 미쿠가 잠에서 깨어나는 중이에요…' "${frames:i++%10:1}"
    sleep 0.1
done
wait "$pid"; rc=$?
printf '\r\033[K'
sid=$(grep -o 'session_id: [^ ]*' "$err" | tail -1 | cut -d' ' -f2)

if [ $rc -eq 0 ] && [ -s "$out" ]; then
    fold -s -w $(( $(tput cols) - 4 )) "$out" | sed 's/^/  /'
else
    echo "  마스터, 안녕하세요! 오늘은 인사말을 불러오지 못했어요 >_<"
fi
rm -f "$out" "$err"

echo
if [ -n "$sid" ]; then
    printf '  \033[2mEnter: 미쿠와 이어서 대화하기  ·  다른 키: 셸로 가기\033[0m'
    IFS= read -rsn1 key; echo
    if [ -z "$key" ]; then
        printf '\033[H\033[2J\033[3J'   # wipe the greeting (screen + scrollback) before Hermes takes over
        exec "$HERMES" chat --resume "$sid"
    fi
fi
exec fish
