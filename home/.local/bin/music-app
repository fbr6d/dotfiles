#!/usr/bin/python3
"""음악 앱 고르기: Spotify ↔ 유튜브 뮤직(Pear Desktop). 2026-11-24 미쿠 (마스터 요청).

  music-app get             지금 고른 앱 이름 (spotify | youtube-music)
  music-app set <앱>        앱 고르기. 다른 앱이 재생 중이면 일시정지하고,
                            팝업이 떠 있었으면 고른 앱 창으로 바꿔 띄운다.
  music-app toggle          고른 앱 창을 바 아래 팝업으로 보이기/숨기기
                            (탭 줄은 Quickshell MusicTabs.qml 이 창을 보고 따라 뜬다)
  music-app player [앱]     그 앱의 playerctl 이름 (재생기가 없으면 빈 줄 + 종료 1)
  music-app autostart       로그인 때: 고른 앱을 숨긴 채(작업공간 99) 켠다

상태 파일: ~/.local/state/miku/music-app (한 줄). 숨김은 popup-window 와 같은 작업공간 99.
유튜브 뮤직 = Chromium 웹앱 (2026-11-24 마스터: Pear Desktop 대신). 자기만의 프로필(UDD)을 써서
재생기(MPRIS)·소리가 마스터의 다른 Chromium(유튜브 앱 등)과 섞이지 않는다.
"""
import json
import os
import shlex
import subprocess
import sys
import time

UDD = os.path.expanduser("~/.local/share/miku/ytmusic-web")   # 웹앱 전용 Chromium 프로필

STATE = os.path.expanduser("~/.local/state/miku/music-app")
HIDDEN = 99
GEOM = (8, 87, 900, 601)   # 탭 줄(y 48, 높이 32) 바로 아래, 간격 7px
APPS = {
    "spotify": {"label": "Spotify", "class": "spotify", "cmd": ["spotify-launcher"]},
    "youtube-music": {"label": "YouTube Music", "class": "chrome-music.youtube.com__-default",
                      "cmd": ["chromium", f"--user-data-dir={UDD}", "--ozone-platform=wayland",
                              "--no-first-run", "--no-default-browser-check", "--lang=ko",
                              "--app=https://music.youtube.com"]},
}
DEFAULT = "spotify"


def get_app():
    try:
        with open(STATE) as f:
            a = f.read().strip()
        return a if a in APPS else DEFAULT
    except OSError:
        return DEFAULT


def save_app(a):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        f.write(a + "\n")
    os.replace(tmp, STATE)


# ---------- 재생기(MPRIS) ----------
def is_web_pid(pid):
    """이 PID(또는 조상)가 웹앱 전용 Chromium 프로필로 실행됐나"""
    pid = str(pid)
    for _ in range(6):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                if f"--user-data-dir={UDD}".encode() in f.read():
                    return True
            with open(f"/proc/{pid}/stat") as f:
                pid = f.read().rsplit(")", 1)[1].split()[1]
        except (OSError, IndexError):
            return False
        if pid in ("0", "1"):
            return False
    return False


def player_name(app):
    """playerctl 이 쓰는 이름. 웹앱은 'chromium.instance<PID>' (PID 가 전용 프로필인 것)."""
    r = subprocess.run(["playerctl", "-l"], capture_output=True, text=True)
    for name in r.stdout.split():
        low = name.lower()
        if app == "spotify" and low.startswith("spotify"):
            return name
        if app == "youtube-music":
            if low.startswith("chromium.instance") and is_web_pid(low[len("chromium.instance"):]):
                return name
    return ""


def pause(app):
    name = player_name(app)
    if name:
        subprocess.run(["playerctl", "-p", name, "pause"], capture_output=True)


# ---------- 창 (popup-window 와 같은 방식) ----------
def hypr(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def dispatch(lua):
    hypr("dispatch", lua)


def find(app):
    cls = APPS[app]["class"]
    try:
        clients = json.loads(hypr("-j", "clients"))
    except ValueError:
        return None
    for c in clients:
        if c["class"].lower() == cls:
            return c
    return None


def active_ws():
    return json.loads(hypr("-j", "activeworkspace"))


def is_shown(c):
    return c is not None and c["workspace"]["name"] == active_ws()["name"]


def show(c):
    win = f'"address:{c["address"]}"'
    ws = active_ws()["id"]
    x, y, w, h = GEOM
    # 숨김 공간(99)에 있는 동안 먼저 떠 있게·크기·자리를 맞춘 뒤 데려온다.
    # (먼저 데려오면 원래 자리에서 보였다가 미끄러져 감 — 2026-11-24 마스터 지적)
    dispatch(f'hl.dsp.window.float({{ window = {win}, action = "enable" }})')
    dispatch(f"hl.dsp.window.resize({{ window = {win}, x = {w}, y = {h} }})")
    dispatch(f"hl.dsp.window.move({{ window = {win}, x = {x}, y = {y} }})")
    dispatch(f"hl.dsp.window.move({{ window = {win}, workspace = {ws}, follow = false }})")
    dispatch(f"hl.dsp.window.move({{ window = {win}, x = {x}, y = {y} }})")   # 작업공간을 옮기며 좌표가 바뀌는 경우 대비
    # 맨 위로 먼저 (alter_zorder 가 초점을 원래 창으로 되돌리므로 focus 보다 앞에)
    dispatch(f'hl.dsp.window.alter_zorder({{ window = {win}, mode = "top" }})')
    # 초점은 주되 마우스는 그대로 (focus 는 마우스를 창 가운데로 옮긴다 — 2026-11-24 마스터 지적).
    # 그 순간만 cursor.no_warps 를 켰다가 끈다 (hyprctl eval 한 번에).
    hypr("eval", "hl.config({ cursor = { no_warps = true } }); "
                 f"hl.dispatch(hl.dsp.focus({{ window = {win} }})); "
                 "hl.config({ cursor = { no_warps = false } })")


def park(c):
    if c:
        dispatch(f'hl.dsp.window.move({{ window = "address:{c["address"]}", '
                 f'workspace = {HIDDEN}, follow = false }})')


def launch(app, then_show):
    """앱을 켜고 창이 생기면 보이거나(then_show) 숨긴다. 창 규칙이 처음엔 99 에 둔다."""
    # Hyprland 가 켜게 한다 (어디서 불려도 화면 환경이 맞고, 부른 쪽이 끝나도 같이 안 꺼짐)
    line = " ".join(shlex.quote(a) for a in APPS[app]["cmd"])
    dispatch("hl.dsp.exec_cmd(" + json.dumps(line) + ")")
    for _ in range(150):   # Spotify 는 class 를 늦게 붙인다
        time.sleep(0.2)
        c = find(app)
        if c:
            show(c) if then_show else park(c)
            return True
    return False


def bring(app):
    c = find(app)
    if c:
        show(c)
    else:
        launch(app, True)


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "get"
    app = get_app()
    if cmd == "get":
        print(app)
    elif cmd == "player":
        name = player_name(args[1] if len(args) > 1 and args[1] in APPS else app)
        print(name)
        sys.exit(0 if name else 1)
    elif cmd == "set":
        new = args[1] if len(args) > 1 else ""
        if new not in APPS:
            sys.exit("music-app set spotify|youtube-music")
        if new == app:
            return
        old_c = find(app)
        was_open = is_shown(old_c)
        pause(app)
        save_app(new)
        if was_open:
            park(old_c)
            bring(new)
    elif cmd == "toggle":
        c = find(app)
        if is_shown(c):
            park(c)
            return
        for other in APPS:            # 다른 앱 팝업(떠 있는 창)이 보이면 같이 숨긴다. 마스터가 타일로 둔 창은 그대로
            if other != app and is_shown(oc := find(other)) and oc.get("floating"):
                park(oc)
        bring(app)
    elif cmd == "autostart":
        if not find(app):
            launch(app, False)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
