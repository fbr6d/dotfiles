[Desktop Entry]
Name=Neovim
GenericName=Text Editor
Comment=Edit text files in Neovim (in a kitty window)
Exec=kitty --class nvim -e nvim %F
Icon=nvim
Type=Application
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/x-rust;text/x-shellscript;application/x-shellscript;application/json;application/toml;application/x-yaml;text/x-lua;text/css;text/csv;application/xml;
NoDisplay=true
