def weather_message(temp, code):
    if code in SNOW_CODES:
        kind = "snow"
    elif code in RAIN_CODES:
        kind = "rain"
    elif temp <= 0:
        kind = "freezing"
    elif temp <= 8:
        kind = "cold"
    elif temp <= 16:
        kind = "cool"
    elif temp <= 24:
        kind = "nice"
    elif temp <= 29:
        kind = "warm"
    else:
        kind = "hot"
    return random.choice(WEATHER_MESSAGES[kind])


