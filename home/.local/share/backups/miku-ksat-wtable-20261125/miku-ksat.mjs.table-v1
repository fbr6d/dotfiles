// KSAT W단계 사실상 진행도 표 — 오른쪽 위, 미쿠 도트 그림 아래.
// 2026-11-25 마스터: '대시보드가 이미 있으니 TUI 위젯은 실질적 W수치 표로 바꾸자'.
//   막대·무게·Codex·과목 줄·칸반 현황·실행 카드 줄은 대시보드에서 보므로 뺐다.
//   이전판 ~/.local/share/backups/miku-ksat-wtable-20261125/miku-ksat.mjs
// scripts/ksat_real_stages.py --json(읽기 전용)을 REFRESH_MS마다 불러 표를 그린다.
//   보정: W4 ≤ W3, W5 = 절반(교재 조사)은 위젯 값 + 절반(위키 보강)은 W3 이하. 초록 ✓ = 원장 [단계 완료].
// 켜기/끄기: /miku-ksat   다시 읽기: /widgets-reload
import { execFile } from 'node:child_process'
import { join } from 'node:path'

const SCRIPT = join(process.env.HOME || '', '.hermes/profiles/miku/scripts/ksat_real_stages.py')
const REFRESH_MS = 10 * 1000
const WIDTH = 54 // miku-art 칸 폭과 맞춘다
// ~/Documents/design-guide.md 토큰: 무채색 우선, 색은 상태에만(완료 green, 주의 peach, 위험 red)
const G = {
  text: '#faf9f5', muted: '#c2c0b6', dim: '#9c9a92', raised: '#4a4a47', surface: '#30302e',
  green: '#a6e3a1', blue: '#89b4fa', peach: '#fab387', red: '#f38ba8', mauve: '#cba6f7',
}
const SHORT_SUB = { 통합사회: '사회', 통합과학: '과학' }
const SHORT_STAGE = { W1: '범위', W2: '개념', W3: '집필', W4: '검수', W5: '암기', W6: '인수' }
const LABEL_W = 10
const CELL_W = 7

function fetchTable() {
  return new Promise(resolve => {
    execFile('python3', [SCRIPT, '--json'], { timeout: 9000, env: process.env }, (err, out) => {
      if (err) return resolve({ error: 'W단계 표를 못 읽었어요' })
      try {
        resolve(JSON.parse(String(out).trim().split('\n').pop()))
      } catch {
        resolve({ error: 'W단계 표를 해석 못 했어요' })
      }
    })
  })
}

const pad = v => String(v).padStart(2, '0')
// 화면 폭: 한글·전각 문자는 2칸
const cellW = ch => (/[\u1100-\u115F\u2E80-\uA4CF\uAC00-\uD7A3\uF900-\uFAFF\uFE30-\uFE4F\uFF00-\uFF60\uFFE0-\uFFE6]/.test(ch) ? 2 : 1)
const width = s => [...s].reduce((n, ch) => n + cellW(ch), 0)
const padTo = (s, w) => s + ' '.repeat(Math.max(0, w - width(s)))
const padLeft = (s, w) => ' '.repeat(Math.max(0, w - width(s))) + s

export default function register(sdk) {
  const { Box, Text, React, defineWidgetApp, h, openWidget } = sdk

  function Board() {
    const [p, setP] = React.useState(null)
    React.useEffect(() => {
      let alive = true
      let busy = false // 앞 계산이 안 끝났으면 이번 차례는 건너뛴다
      const load = () => {
        if (busy) return
        busy = true
        fetchTable().then(r => {
          busy = false
          if (alive) setP(r)
        })
      }
      load()
      const id = setInterval(load, REFRESH_MS)
      return () => {
        alive = false
        clearInterval(id)
      }
    }, [])

    let k = 0
    const T = (color, text, extra) => h(Text, { color, key: k++, ...(extra || {}) }, text)
    // 한 줄은 Text 하나 안의 중첩 Text로 묶는다(Ink가 조각 끝 빈칸을 지워 칸이 어긋나는 것 방지)
    const Row = (...kids) => h(Text, { key: k++, wrap: 'truncate' }, ...kids)
    const rows = []

    if (!p) rows.push(T(G.dim, 'W단계 계산 중…'))
    else if (p.error) rows.push(T(G.red, p.error))
    else {
      rows.push(Row(
        T(G.dim, padTo('단계', LABEL_W)),
        ...p.subjects.map(s => T(G.text, padLeft(SHORT_SUB[s] || s, CELL_W), { bold: true }))
      ))
      for (const r of p.rows) {
        rows.push(Row(
          T(G.dim, padTo(`${r.code} ${SHORT_STAGE[r.code] || r.name}`, LABEL_W)),
          ...r.cells.map(c => {
            const txt = c.done ? `✓${c.pct}` : `${c.pct}`
            const col = c.done ? G.green : c.pct === 0 ? G.raised : G.text
            return T(col, padLeft(txt, CELL_W), c.done ? { bold: true } : undefined)
          })
        ))
      }
      const at = new Date((p.at || Date.now() / 1000) * 1000)
      rows.push(T(G.dim, `${pad(at.getHours())}:${pad(at.getMinutes())}:${pad(at.getSeconds())} 기준 · ✓ 단계 완료 · 10초마다`))
    }

    // 칸과 줄마다 flexShrink 0(레일 높이가 모자랄 때 줄이 겹쳐 그려지는 것 방지)
    const fixRow = (r, i) => h(Box, { key: `fix${i}`, flexShrink: 0, height: 1 }, r)
    return h(
      Box,
      { flexDirection: 'column', borderStyle: 'round', borderColor: G.surface, paddingX: 1, width: WIDTH - 2, flexShrink: 0 },
      ...[Row(T(G.text, `KSAT W단계 ${(p && p.version) || ''}`, { bold: true }), T(G.dim, ' · 사실상 %')), ...rows].map(fixRow)
    )
  }

  const app = defineWidgetApp({
    id: 'miku-ksat',
    help: 'KSAT W단계 사실상 진행도 표 (켜기/끄기)',
    mode: 'ambient',
    zone: 'top-right',
    width: WIDTH,
    init: () => ({}),
    reduce: state => state,
    render: () => h(Board),
  })

  openWidget(app, app.init(''))
}
