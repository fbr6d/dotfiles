// 미쿠 TUI 시작 그림 (2026-11-19, 마스터 요청 2번)
// TUI 시작 화면 그림(스킨 banner_hero)은 한 줄에 한 색만 칠할 수 있어 도트 미쿠가 깨진다.
// 그래서 스킨 그림은 비우고(skins/miku.yaml banner_hero " ", 원본 miku.yaml.bak-hero-widget),
// 부팅 인사 창과 같은 원본 ~/.local/share/miku/miku.ans 를 글자색+배경색 그대로 오른쪽 위에 띄운다.
// 그림은 고치지 않고 색만 옮긴다. 계속 떠 있다(AUTO_HIDE=false).
// 켜기/끄기: /miku-art
import { readFileSync } from 'node:fs'
import { join } from 'node:path'

const HOME = process.env.HERMES_HOME || join(process.env.HOME || '', '.hermes/profiles/miku')
const ART = join(process.env.HOME || '', '.local/share/miku/miku.ans')

const AUTO_HIDE = false // true면 첫 메시지 뒤 저절로 숨김
const REDRAW_MS = 60 * 1000 // 2026-11-23 마스터: 1분마다 다시 그리기 (백업 ~/.local/share/backups/tui-widgets-detail-20261123/)
const REDRAW_BLANK_MS = 150

let DatabaseSync = null
try {
  ;({ DatabaseSync } = await import('node:sqlite'))
} catch {}

const hex = (r, g, b) => '#' + [r, g, b].map(v => Number(v).toString(16).padStart(2, '0')).join('')

// ANSI(38;2 / 48;2 트루컬러 + 0 초기화)를 [{text, fg, bg}] 줄 목록으로
function parseAns(src) {
  const lines = src.replace(/\r/g, '').split('\n')
  while (lines.length && !lines[lines.length - 1].trim()) lines.pop()
  return lines.map(line => {
    const segs = []
    let fg = null
    let bg = null
    const re = /\x1b\[([0-9;]*)m|([^\x1b]+)/g
    let m
    while ((m = re.exec(line))) {
      if (m[2] !== undefined) {
        const last = segs[segs.length - 1]
        if (last && last.fg === fg && last.bg === bg) last.text += m[2]
        else segs.push({ text: m[2], fg, bg })
        continue
      }
      const p = (m[1] || '0').split(';').map(Number)
      for (let i = 0; i < p.length; i++) {
        if (p[i] === 0) fg = bg = null
        else if (p[i] === 39) fg = null
        else if (p[i] === 49) bg = null
        else if ((p[i] === 38 || p[i] === 48) && p[i + 1] === 2) {
          const c = hex(p[i + 2], p[i + 3], p[i + 4])
          if (p[i] === 38) fg = c
          else bg = c
          i += 4
        }
      }
    }
    return segs
  })
}

let ART_LINES = []
try {
  ART_LINES = parseAns(readFileSync(ART, 'utf8'))
} catch {}
const ART_W = ART_LINES.reduce((w, segs) => Math.max(w, segs.reduce((n, s) => n + [...s.text].length, 0)), 0)

// 지금 대화에 사용자 메시지가 있는지 (있으면 시작 화면이 끝난 것)
function chatStarted(db) {
  try {
    const file = process.env.HERMES_TUI_ACTIVE_SESSION_FILE
    const sid = file ? JSON.parse(readFileSync(file, 'utf8')).session_id : null
    if (!db || !sid) return false
    return !!db.prepare("SELECT 1 FROM messages WHERE session_id = ? AND role = 'user' LIMIT 1").get(sid)
  } catch {
    return false
  }
}

export default function register(sdk) {
  const { Box, Text, React, defineWidgetApp, h, openWidget, updateWidget } = sdk
  let app
  let booted = false // 자동으로 한 번 띄운 뒤에는 /miku-art 로 켠 것(수동)

  // 숨길 때는 같은 id를 폭 0으로 다시 등록해 오른쪽 칸 예약도 없앤다 (SDK에 ambient 닫기 함수가 없음)
  const define = width =>
    defineWidgetApp({
      id: 'miku-art',
      help: '시작 화면 도트 미쿠 그림 (켜기/끄기)',
      mode: 'ambient',
      zone: 'top-right',
      width,
      init: () => {
        const manual = booted
        if (manual) app = define(ART_W + 2) // 숨기며 폭 0으로 바꾼 것을 되돌림
        return { hidden: false, manual }
      },
      reduce: state => state,
      render: ({ state }) => (state.hidden ? null : h(Art, { manual: state.manual }))
    })

  function hide() {
    app = define(0)
    updateWidget(app, s => ({ ...s, hidden: true }))
  }

  function Art({ manual }) {
    // 2026-11-23 마스터: 도트 그림이 자꾸 깨져서 1분마다 다시 그린다. 화면 그리기는 바뀐 칸만 다시 쓰므로
    // 같은 그림을 다시 그려도 깨진 칸이 안 고쳐진다 → 아주 잠깐(0.15초) 같은 크기의 빈칸으로 바꿨다가 되돌려 모든 칸을 새로 쓴다.
    const [blank, setBlank] = React.useState(false)
    React.useEffect(() => {
      let off = null
      const id = setInterval(() => {
        setBlank(true)
        off = setTimeout(() => setBlank(false), REDRAW_BLANK_MS)
      }, REDRAW_MS)
      return () => {
        clearInterval(id)
        if (off) clearTimeout(off)
      }
    }, [])
    React.useEffect(() => {
      if (manual || !AUTO_HIDE) return undefined // 마스터 요청(2026-11-19): 자동으로 숨기지 않음, /miku-art 로만 끈다
      let db = null
      try {
        if (DatabaseSync) db = new DatabaseSync(join(HOME, 'state.db'), { readOnly: true })
      } catch {}
      const id = setInterval(() => {
        if (chatStarted(db)) {
          clearInterval(id)
          hide()
        }
      }, 1000)
      return () => {
        clearInterval(id)
        try {
          db && db.close()
        } catch {}
      }
    }, [])

    return h(
      Box,
      { flexDirection: 'column', width: ART_W, paddingTop: 1 },
      ...ART_LINES.map((segs, i) =>
        h(
          Box,
          { key: i, flexDirection: 'row', height: 1 },
          ...(blank
            ? [h(Text, { key: 'b' }, ' '.repeat(ART_W))]
            : segs.map((s, j) => h(Text, { key: j, color: s.fg || undefined, backgroundColor: s.bg || undefined }, s.text)))
        )
      )
    )
  }

  app = define(ART_W + 2)
  if (ART_LINES.length) openWidget(app, app.init(''))
  booted = true
}
