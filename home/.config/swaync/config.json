{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-right": 8,
  "control-center-margin-bottom": 8,
  "control-center-width": 380,
  "control-center-height": 0,
  "notification-window-width": 380,
  "fit-to-screen": false,
  "hide-on-clear": false,
  "hide-on-action": true,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "widgets": [
    "buttons-grid",
    "volume",
    "backlight",
    "buttons-grid#power",
    "slider#battery",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "알림",
      "clear-all-button": true,
      "button-text": "모두 지우기"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃠",
      "device": "acpi_video0"
    },
    "slider#battery": {
      "label": "󰁹  배터리",
      "cmd_getter": "cat /sys/class/power_supply/BAT0/capacity",
      "cmd_setter": "true",
      "min": 0,
      "max": 100,
      "min_limit": 0,
      "max_limit": 100
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩  Wi-Fi",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && echo true || echo false'"
        },
        {
          "label": "󰂯  Bluetooth",
          "type": "toggle",
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "󰂱  기기 연결",
          "command": "sh -c 'swaync-client -cp; overskride'"
        },
        {
          "label": "󰂛  방해 금지",
          "type": "toggle",
          "command": "sh -c 'swaync-client -d -sw'",
          "update-command": "sh -c 'swaync-client -D -sw'"
        }
      ]
    },
    "buttons-grid#power": {
      "actions": [
        {
          "label": "󰌾",
          "command": "sh -c 'swaync-client -cp -sw; loginctl lock-session'"
        },
        {
          "label": "󰜉",
          "command": "/home/leejaeik/.local/bin/power-confirm reboot"
        },
        {
          "label": "󰐥",
          "command": "/home/leejaeik/.local/bin/power-confirm poweroff"
        }
      ]
    }
  },
  "scripts": {
    "focus-sender": {
      "exec": "/home/leejaeik/.local/bin/notify-focus",
      "app-name": ".*",
      "run-on": "action"
    }
  },
  "script-fail-notify": false,
  "notification-visibility": {
    "dotfiles-backup": {
      "state": "transient",
      "app-name": "^Backup$"
    }
  }
}
