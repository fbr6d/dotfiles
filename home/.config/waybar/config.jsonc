// Waybar: monochrome dark bar (Claude grays), Catppuccin Mocha only for highlighted text
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    // GTK adds ~6px around each pill; spacing 8 makes the visible gap 14px
    "spacing": 8,

    // Only the workspace island is shown; the other modules stay defined below.
    // To bring them back:
    //   "modules-left": ["clock"],
    //   "modules-right": ["network", "bluetooth", "wireplumber", "backlight", "battery", "tray"],
    "modules-left": ["group/left", "custom/lyrics"],
    "modules-center": ["custom/island"],
    "modules-right": ["group/right"],

    // Menu button: opens the control center popup (Wi-Fi, Bluetooth, sound, display)
    "custom/control": {
        "format": "󰍜",
        "tooltip": false,
        "on-click": "swaync-client -t -sw"
    },

    // Dynamic island: display-only workspace dots (one per workspace, the active one
    // a white pill). Clicking anywhere on it opens the wallpaper picker.
    "custom/island": {
        "exec": "~/.local/bin/waybar-island",
        "return-type": "json",
        "restart-interval": 2,
        "on-click": "~/.local/bin/popup-toggle waypaper waypaper"
    },

    // (old, clickable) dynamic-island dots, kept for reference
    "hyprland/workspaces": {
        "format": "",
        "show-special": false,
        "sort-by": "number",
        "tooltip": false,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },

    // Left pill: sound visualizer; click shows/hides Spotify as a popup
    "custom/cava": {
        "exec": "~/.local/bin/waybar-cava",
        "format": "{}",
        "restart-interval": 5,
        "on-click": "~/.local/bin/spotify-popup",
        "tooltip": false
    },

    // Left: visualizer; hovering it slides out the Spotify controls (drawer).
    // The controls also stay hidden while Spotify has no track.
    // Right: clock; hovering it slides out the tray (background apps, e.g. LocalSend)
    // to its left. swaync has no tray, so it lives here next to the control center button.
    "group/right": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "tray-drawer"
        },
        "modules": ["clock", "tray"]
    },
    "group/left": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true,
            "children-class": "media-drawer"
        },
        "modules": ["custom/cava", "custom/media-prev", "custom/media-play", "custom/media-next"]
    },
    "custom/media-prev": {
        "exec": "~/.local/bin/waybar-media prev",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "playerctl --player=spotify previous"
    },
    "custom/media-play": {
        "exec": "~/.local/bin/waybar-media play",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "playerctl --player=spotify play-pause"
    },
    "custom/media-next": {
        "exec": "~/.local/bin/waybar-media next",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "playerctl --player=spotify next"
    },

    // Synced lyrics (LRCLIB) for the Spotify track; hidden when there are none
    "custom/lyrics": {
        "exec": "~/.local/bin/waybar-lyrics",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "~/.local/bin/spotify-popup"
    },

    // Clock at the far right: click toggles the swaync control center
    "clock": {
        "format": "{:%H:%M}",
        "on-click": "swaync-client -t -sw",
        "tooltip": false   // no calendar popup on hover
    },

    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  유선",
        "format-disconnected": "󰤭  연결 없음",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "on-click": "swaync-client -t -sw"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-connected": "󰂱  {num_connections}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "swaync-client -t -sw"
    },

    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  음소거",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "swaync-client -t -sw",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "backlight": {
        "format": "󰃠  {percent}%",
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
    },

    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
