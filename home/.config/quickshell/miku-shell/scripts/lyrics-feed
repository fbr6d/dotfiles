#!/usr/bin/python3
"""상단 바 가사 칸용: 고른 음악 앱(Spotify 또는 유튜브 뮤직) 곡 정보와 지금 가사 줄을 JSON 한 줄씩 출력 (바뀔 때만).
  {"show": bool, "info": "제목 · 아티스트", "line": "가사 줄" 또는 "", "lyrics": 가사 있음 여부}
가사는 LRCLIB(lrclib.net)에서 받아 ~/.cache/waybar-lyrics 에 곡마다 저장한다 (예전 waybar-lyrics 와 같은 캐시).
글자 폭 재기·자르기·폭 애니메이션·흐르는 제목은 전부 Quickshell(Bar.qml)이 그린다."""
import hashlib
import json
import os
import re
import subprocess
import threading
import time
import urllib.parse
import urllib.request

CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "waybar-lyrics")
API = "https://lrclib.net/api"
UA = "miku-shell lyrics (personal desktop widget)"
TICK_S = 0.2
LEAD_S = 0.3        # Spotify 처럼 줄을 살짝 일찍 보여 준다
FMT = "{{status}}\t{{xesam:artist}}\t{{xesam:title}}\t{{xesam:album}}\t{{mpris:length}}\t{{position}}"
TIMESTAMP = re.compile(r"\[(\d+):(\d+(?:\.\d+)?)\]")


_player = {"name": "", "at": 0.0}


def player_name():
    """마스터가 고른 음악 앱의 playerctl 이름 (~/.local/bin/music-app, 2초마다 다시 확인). 2026-11-24"""
    now = time.monotonic()
    if now - _player["at"] > 2:
        _player["at"] = now
        try:
            _player["name"] = subprocess.run([os.path.expanduser("~/.local/bin/music-app"), "player"],
                                             capture_output=True, text=True, timeout=3).stdout.strip()
        except Exception:
            _player["name"] = ""
    return _player["name"]


def player_state():
    name = player_name()
    if not name:
        return None
    r = subprocess.run(["playerctl", "--player=" + name, "metadata", "--format", FMT],
                       capture_output=True, text=True)
    f = r.stdout.rstrip("\n").split("\t")
    if r.returncode != 0 or len(f) != 6:
        return None
    status, artist, title, album, length, pos = f
    to_s = lambda us: int(us) / 1e6 if us.isdigit() else 0.0
    return {"status": status, "artist": artist, "title": title, "album": album,
            "duration": to_s(length), "position": to_s(pos)}


def parse_lrc(text):
    lines = []
    for raw in text.splitlines():
        stamps = TIMESTAMP.findall(raw)
        words = TIMESTAMP.sub("", raw).strip()
        for m, s in stamps:
            lines.append((int(m) * 60 + float(s), words))
    return sorted(lines)


def http_json(path, params):
    url = f"{API}/{path}?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.load(r)
    except Exception:
        return None


def fetch_synced(track):
    """곡의 시간 맞춘 가사(LRC) 글. 없으면 ""."""
    hit = http_json("get", {"artist_name": track["artist"], "track_name": track["title"],
                            "album_name": track["album"], "duration": round(track["duration"])})
    if hit and hit.get("syncedLyrics"):
        return hit["syncedLyrics"]
    # 없으면 검색해서 곡 길이가 가장 가까운 것
    found = [x for x in (http_json("search", {"artist_name": track["artist"],
                                              "track_name": track["title"]}) or [])
             if x.get("syncedLyrics")]
    if not found:
        return ""
    return min(found, key=lambda x: abs((x.get("duration") or 0) - track["duration"]))["syncedLyrics"]


class Lyrics:
    def __init__(self):
        self.key = None
        self.lines = []

    def load(self, track):
        key = (track["artist"], track["title"])
        if key == self.key:
            return
        self.key, self.lines = key, []
        os.makedirs(CACHE, exist_ok=True)
        path = os.path.join(CACHE, hashlib.sha1("\t".join(key).encode()).hexdigest() + ".lrc")
        if os.path.exists(path):
            with open(path) as f:
                self.lines = parse_lrc(f.read())
            return

        def work():
            text = fetch_synced(track)
            with open(path, "w") as f:   # 빈 파일 = "가사 없음"을 기억
                f.write(text)
            if self.key == key:
                self.lines = parse_lrc(text)
        threading.Thread(target=work, daemon=True).start()

    def line_at(self, t):
        current = ""
        for start, words in self.lines:
            if start > t + LEAD_S:
                break
            current = words
        return current


def main():
    lyrics = Lyrics()
    last = None
    while True:
        st = player_state()
        out = {"show": False, "info": "", "line": "", "lyrics": False}
        if st and st["title"] and st["status"] == "Playing":
            lyrics.load(st)
            out["show"] = True
            out["info"] = f"{st['title']} · {st['artist']}" if st["artist"] else st["title"]
            out["lyrics"] = bool(lyrics.lines)
            if lyrics.lines:
                out["line"] = lyrics.line_at(st["position"]) or "♪"
        if out != last:
            print(json.dumps(out, ensure_ascii=False), flush=True)
            last = out
        time.sleep(TICK_S)


if __name__ == "__main__":
    main()
