#!/usr/bin/python3
"""상단 바 시스템 상태 알약용: 온도 · iCloud 백업 · iCloud 인증 남은 날을 JSON 한 줄로 출력 (읽기 전용).
alerts 가 비어 있으면 바에서는 알약을 숨긴다 (오른쪽에 마우스를 올리면 자세히 펼쳐짐)."""
import datetime as dt
import json
import os
import re
import subprocess

HOME = os.path.expanduser("~")
B = os.path.join(HOME, ".local/share/miku-backup")
CPU_HOT = 85
AUTH_WARN_DAYS = 7


def sh(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""


def temps():
    cpu = gpu = ssd = None
    try:
        data = json.loads(sh("sensors", "-j") or "{}")
    except Exception:
        data = {}
    ssds = []
    for chip, vals in data.items():
        for feat, d in vals.items():
            if not isinstance(d, dict):
                continue
            t = next((v for k, v in d.items() if k.endswith("_input")), None)
            if t is None:
                continue
            if chip.startswith("k10temp") and feat == "Tctl":
                cpu = round(t)
            elif chip.startswith("amdgpu-pci-0300") and feat == "edge":
                gpu = round(t)
            elif chip.startswith("nvme") and feat == "Composite":
                ssds.append(round(t))
    if ssds:
        ssd = max(ssds)
    return cpu, gpu, ssd


def backup():
    st = {}
    try:
        st = json.load(open(os.path.join(B, "status.json")))
    except Exception:
        pass
    active = sh("systemctl", "--user", "is-active", "miku-backup.service").strip()
    running = active in ("active", "activating")
    pct = None
    if running:
        logs = sorted((f for f in os.listdir(os.path.join(B, "logs")) if f.endswith(".log")), reverse=True)
        if logs:
            with open(os.path.join(B, "logs", logs[0]), "rb") as f:
                f.seek(0, 2)
                f.seek(max(0, f.tell() - 200000))
                tail = f.read().decode("utf-8", "ignore")
            m = re.findall(r"GiB / [\d.]+ GiB, (\d+)%", tail)
            pct = int(m[-1]) if m else None
    fin = st.get("finished")
    when = dt.datetime.fromtimestamp(fin).strftime("%-m/%-d %H:%M") if fin else None
    return {"running": running, "pct": pct, "result": st.get("result"), "finished": when}


def auth_days():
    try:
        d = dt.date.fromisoformat(open(os.path.join(B, "icloud-auth-date")).read().strip())
        return (d + dt.timedelta(days=30) - dt.date.today()).days
    except Exception:
        return None


cpu, gpu, ssd = temps()
bk = backup()
ad = auth_days()
alerts = []  # (단계, 짧은 글자) 단계: red / yellow / info
if cpu is not None and cpu >= CPU_HOT:
    alerts.append({"level": "red", "text": f"CPU {cpu}°"})
if bk["running"]:
    alerts.append({"level": "info", "text": f"백업 {bk['pct']}%" if bk["pct"] is not None else "백업 중"})
elif bk["result"] == "실패":
    alerts.append({"level": "red", "text": "백업 실패"})
if ad is not None and ad <= AUTH_WARN_DAYS:
    alerts.append({"level": "yellow" if ad > 0 else "red", "text": f"iCloud 인증 D-{ad}" if ad > 0 else "iCloud 인증 만료"})

# 사용률(%): CPU는 지난 실행(약 15초 전)과의 /proc/stat 차이, GPU는 RX 6600(03:00.0) 사용률, RAM은 MemAvailable 기준
def cpu_usage():
    with open("/proc/stat") as f:
        v = [int(x) for x in f.readline().split()[1:]]
    idle, total = v[3] + v[4], sum(v)
    state = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "miku-sys-status-cpu")
    prev = None
    try:
        with open(state) as f:
            prev = [int(x) for x in f.read().split()]
    except (OSError, ValueError):
        pass
    try:
        with open(state, "w") as f:
            f.write(f"{idle} {total}")
    except OSError:
        pass
    if not prev or total <= prev[1]:
        return None
    return round(100 * (1 - (idle - prev[0]) / (total - prev[1])))


def gpu_usage():
    try:
        with open("/sys/bus/pci/devices/0000:03:00.0/gpu_busy_percent") as f:
            return int(f.read())
    except (OSError, ValueError):
        return None


def ram_usage():
    m = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":")
            m[k] = int(v.split()[0])
    return round(100 * (1 - m["MemAvailable"] / m["MemTotal"]))


cpu_u, gpu_u, ram_u = cpu_usage(), gpu_usage(), ram_usage()
detail = [f"CPU {cpu_u}%" if cpu_u is not None else "CPU …",
          f"GPU {gpu_u}%" if gpu_u is not None else "GPU ?",
          f"RAM {ram_u}%"]
if bk["running"]:
    detail.append(f"백업 {bk['pct']}%" if bk["pct"] is not None else "백업 중")
elif bk["result"]:
    detail.append(f"백업 {bk['result']} {bk['finished'] or ''}".strip())
if ad is not None:
    detail.append(f"인증 D-{ad}")

# 사용률 색 단계 (바에서 글자 색으로 씀): ok 초록 / warm 노랑 / hot 주황 / crit 빨강
USE_STEPS = {"CPU": (50, 75, 90), "GPU": (50, 75, 90), "RAM": (50, 75, 90)}


def level(name, v):
    if v is None:
        return ""
    w, h, c = USE_STEPS[name]
    return "crit" if v >= c else "hot" if v >= h else "warm" if v >= w else "ok"


parts = [{"text": detail[0], "level": level("CPU", cpu_u)},
         {"text": detail[1], "level": level("GPU", gpu_u)},
         {"text": detail[2], "level": level("RAM", ram_u)}]
parts += [{"text": d, "level": ""} for d in detail[3:]]

print(json.dumps({"alerts": alerts, "detail": " · ".join(detail), "parts": parts}, ensure_ascii=False))
